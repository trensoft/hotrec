#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "इसके बारे में"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "संस्करण %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "GNOME के लिए स्क्रीन और ध्वनि रिकॉर्डर, जो कीबोर्ड शॉर्टकट से संचालित होता है।"

#: hotrec/about_window.py
msgid "Website"
msgstr "वेबसाइट"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "समस्या की रिपोर्ट करें"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "लाइसेंस: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "बंद करें"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "कीबोर्ड शॉर्टकट सेट नहीं किए जा सके"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "कीबोर्ड शॉर्टकट सेट हो गए हैं"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: स्क्रीन और ध्वनि। Ctrl+Shift+F10: केवल स्क्रीन। Ctrl+Shift+F11: केवल "
"ध्वनि। Ctrl+Shift+F12: रोकें या फिर शुरू करें। पहले तीन में से कोई भी रिकॉर्डिंग को रोककर "
"सहेजता है।"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: क्षेत्र और ध्वनि। Ctrl+Shift+F8: केवल क्षेत्र। दोनों रिकॉर्डिंग को रोकते "
"भी हैं और सहेजते भी हैं।"

#: hotrec/indicator.py
msgid "Paused"
msgstr "रुका हुआ"

#: hotrec/indicator.py
msgid "Resume"
msgstr "फिर शुरू करें"

#: hotrec/indicator.py
msgid "Recording"
msgstr "रिकॉर्ड हो रहा है"

#: hotrec/indicator.py
msgid "Pause"
msgstr "रोकें"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "रोकें और सहेजें"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "सेटिंग्स…"

#: hotrec/indicator.py
msgid "Quit"
msgstr "बंद करें"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API वीडियो ड्राइवर मौजूद नहीं है या काम नहीं कर रहा। Intel ग्राफ़िक्स पर intel-"
"media-driver (RPM Fusion nonfree) इंस्टॉल करें और फिर कोशिश करें।"

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"वीडियो एन्कोडर शुरू नहीं हुआ। हो सकता है ग्राफ़िक्स ड्राइवर में हार्डवेयर वीडियो एन्कोडिंग "
"(VA-API या NVENC) न हो।"

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s रिकॉर्डिंग की स्थिति रखने के लिए सुरक्षित जगह नहीं है"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "रिकॉर्डिंग रुक गई"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "रिकॉर्डिंग शुरू नहीं हो सकी"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "क्षेत्र चुनने वाली विंडो शुरू नहीं हुई"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "रिकॉर्ड करने के लिए ध्वनि आउटपुट नहीं मिला"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "फ़ोल्डर %s नहीं बनाया जा सका"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s इंस्टॉल नहीं है"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s शुरू नहीं हुआ"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "रिकॉर्डिंग शुरू नहीं हो सकी (लॉग: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr "रिकॉर्डिंग सहेजी गई, लेकिन क्षेत्र काटा नहीं जा सका: इसमें पूरी स्क्रीन है"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "रिकॉर्डिंग सहेजी गई"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"केवल दृश्य क्षेत्र तक सीमित किया जाता है: स्क्रीन का बाकी हिस्सा फ़ाइल में ही रहता है"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "रिकॉर्डिंग अधूरी हो सकती है"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "रिकॉर्ड करने का क्षेत्र खींचकर चुनें। Esc या दायाँ बटन रद्द करता है।"

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "सेटिंग्स"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "डिफ़ॉल्ट पर रीसेट करें"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "कीबोर्ड शॉर्टकट"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "किसी फ़ील्ड पर क्लिक करें, फिर नई कुंजियाँ दबाएँ। Esc रद्द करता है।"

#: hotrec/settings_window.py
msgid "Video"
msgstr "वीडियो"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "वीडियो कोडेक"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (हर जगह चलता है)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (फ़ाइल का आकार लगभग आधा)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "वीडियो बिटरेट"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "फ्रेम दर"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "वीडियो फ़ाइल प्रारूप"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 उपलब्ध नहीं है: ग्राफ़िक्स कार्ड इसे एन्कोड नहीं कर सकता।"

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"H.265 वीडियो को Windows और कुछ ब्राउज़रों में चलाने के लिए एक अतिरिक्त कोडेक की "
"आवश्यकता हो सकती है।"

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr ""
"क्षेत्र की रिकॉर्डिंग हमेशा H.264 में होती है, भले ही H.265 चुना गया "
"हो।"

#: hotrec/settings_window.py
msgid "Sound"
msgstr "ध्वनि"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "केवल-ध्वनि रिकॉर्डिंग के लिए ध्वनि कोडेक"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "वीडियो के साथ ध्वनि बिटरेट"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "केवल-ध्वनि रिकॉर्डिंग के लिए ध्वनि बिटरेट"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr "केवल-ध्वनि रिकॉर्डिंग पर लागू होता है। वीडियो के साथ, ध्वनि हमेशा AAC होती है।"

#: hotrec/settings_window.py
msgid "Folders"
msgstr "फ़ोल्डर"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "वीडियो इसमें सहेजे जाते हैं"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "ध्वनि रिकॉर्डिंग इसमें सहेजी जाती हैं"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "चुनें…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "फ़ोल्डर चुनें"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "कुंजियाँ दबाएँ..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "कुंजी के साथ Ctrl, Alt या Super का उपयोग करें।"

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "दो शॉर्टकट की कुंजियाँ एक जैसी हैं।"

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "क्या हर सेटिंग को उसके डिफ़ॉल्ट मान पर रीसेट करें?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"फ़ुलस्क्रीन वीडियो के ऊपर झपकने वाला लाल बिंदु चालू है। इसे आप एक्सटेंशन ऐप में बंद कर सकते हैं।"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"फ़ुलस्क्रीन वीडियो के ऊपर झपकने वाला लाल बिंदु चालू है। यदि यह अभी नहीं दिख रहा है, तो "
"एक बार लॉग आउट करके फिर लॉग इन करें। इसे आप एक्सटेंशन ऐप में बंद कर सकते हैं।"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "क्षेत्र और ध्वनि रिकॉर्ड करें"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "केवल क्षेत्र रिकॉर्ड करें"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "स्क्रीन और ध्वनि रिकॉर्ड करें"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "केवल स्क्रीन रिकॉर्ड करें"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "केवल ध्वनि रिकॉर्ड करें"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "रिकॉर्डिंग रोकें या फिर शुरू करें"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "कीबोर्ड शॉर्टकट से डेस्कटॉप की स्क्रीन और ध्वनि रिकॉर्ड करता है"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "कीबोर्ड शॉर्टकट वाला स्क्रीन और ध्वनि रिकॉर्डर"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"एक कुंजी डेस्कटॉप की स्क्रीन और ध्वनि रिकॉर्ड करती है, दूसरी केवल स्क्रीन, तीसरी केवल ध्वनि "
"MP3 के रूप में। वही कुंजी रिकॉर्डिंग को रोककर सहेजती है; चौथी कुंजी उसे रोकती और फिर शुरू "
"करती है।"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"कुंजियाँ हर विंडो में काम करती हैं, Wayland पर भी। ऊपरी बार में लाल बिंदु बताता है कि "
"रिकॉर्डिंग चल रही है, पीला बिंदु कि वह रुकी हुई है।"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"स्क्रीन को ग्राफ़िक्स हार्डवेयर रिकॉर्ड करता है। फ़ोल्डर, फ़ाइल प्रारूप और बिटरेट एक सरल "
"सेटिंग फ़ाइल में तय किए जाते हैं।"
