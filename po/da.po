#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "Om"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Version %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "Skærm- og lydoptager til GNOME, drevet af tastaturgenveje."

#: hotrec/about_window.py
msgid "Website"
msgstr "Websted"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Rapportér et problem"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licens: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Luk"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Tastaturgenvejene kunne ikke indstilles"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Tastaturgenvejene er indstillet"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Skift+F9: skærm og lyd. Ctrl+Skift+F10: kun skærm. Ctrl+Skift+F11: kun "
"lyd. Ctrl+Skift+F12: pause eller genoptag. En af de første tre stopper og "
"gemmer optagelsen."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Skift+F7: område og lyd. Ctrl+Skift+F8: kun område. Begge stopper og "
"gemmer også optagelsen."

#: hotrec/indicator.py
msgid "Paused"
msgstr "På pause"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Genoptag"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Optager"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pause"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Stop og gem"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Indstillinger…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API-videodriveren mangler eller virker ikke. Med Intel-grafik skal du "
"installere intel-media-driver (RPM Fusion nonfree) og prøve igen."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Videokoderen startede ikke. Grafikdriveren mangler måske hardwarekodning af "
"video (VA-API eller NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s er ikke et sikkert sted for optagelsens tilstand"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Optagelsen blev stoppet"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Optagelsen kunne ikke startes"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Vinduet til valg af område blev ikke startet"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Lydudgangen, der skal optages, blev ikke fundet"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Mappen %s kunne ikke oprettes"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s er ikke installeret"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s startede ikke"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Optagelsen kunne ikke startes (log: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Optagelsen er gemt, men området kunne ikke klippes ud: hele skærmen er med"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Optagelsen er gemt"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Kun visningen beskæres til området: resten af skærmen er stadig i filen"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Optagelsen er muligvis ufuldstændig"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Træk for at vælge området, der skal optages. Esc eller højre knap annullerer."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Indstillinger"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Nulstil til standarder"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Tastaturgenveje"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klik på et felt, og tryk derefter på de nye taster. Esc annullerer."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Video-codec"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (afspilles overalt)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (omkring halv filstørrelse)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Video-bitrate"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Billedhastighed"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Videofilformat"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 er ikke tilgængelig: grafikkortet kan ikke kode den."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"H.265-videoer kan kræve et ekstra codec for at spille på Windows og i visse "
"browsere."

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr "Optagelser af et område er altid H.264, også når H.265 er valgt."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Lyd"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Lyd-codec til optagelser med kun lyd"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Lyd-bitrate med video"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Lyd-bitrate til optagelser med kun lyd"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr "Gælder kun for optagelser med kun lyd. Med video er lyden altid AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Mapper"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Videoer gemmes i"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Lydoptagelser gemmes i"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Vælg…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Vælg en mappe"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Tryk på tasterne..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Brug Ctrl, Alt eller Super sammen med tasten."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "To genveje har de samme taster."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Nulstil alle indstillinger til deres standardværdi?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Den blinkende røde prik over en fuldskærmsvideo er slået til. Du kan slå den "
"fra i appen Udvidelser."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Den blinkende røde prik over en fuldskærmsvideo er slået til. Hvis du ikke "
"kan se den endnu, skal du logge ud og ind igen én gang. Du kan slå den fra i "
"appen Udvidelser."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Optag område og lyd"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Optag kun området"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Optag skærm og lyd"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Optag kun skærmen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Optag kun lyden"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Sæt optagelsen på pause eller genoptag den"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Optag skrivebordets skærm og lyd med tastaturgenveje"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Skærm- og lydoptager med tastaturgenveje"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Én tast optager skrivebordets skærm og lyd, en anden kun skærmen, en tredje "
"kun lyden som MP3. Den samme tast stopper og gemmer optagelsen; en fjerde "
"sætter den på pause og genoptager den."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tasterne virker i alle vinduer, også under Wayland. En rød prik i den "
"øverste bjælke viser, at en optagelse kører, en gul at den er på pause."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Skærmen optages af grafikhardwaren. Mappen, filformatet og bitraterne "
"indstilles i en simpel indstillingsfil."
