#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "No s'han pogut definir les dreceres de teclat"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Les dreceres de teclat estan definides"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Maj+F9: pantalla i so. Ctrl+Maj+F10: només pantalla. Ctrl+Maj+F11: "
"només so. Ctrl+Maj+F12: pausa o represa. Qualsevol de les tres primeres "
"atura i desa l'enregistrament."

#: hotrec/indicator.py
msgid "Paused"
msgstr "En pausa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Reprèn"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Enregistrant"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pausa"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Atura i desa"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Defineix les dreceres de teclat..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Dreceres de teclat"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Feu clic en un camp i premeu les tecles noves. Esc cancel·la."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Desa els vídeos a"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Desa l'àudio a"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Per defecte"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Desa"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Trieu una carpeta"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "No s'han pogut desar les carpetes"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Premeu les tecles..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Useu Ctrl, Alt o Super juntament amb la tecla."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dues dreceres tenen les mateixes tecles."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Falta el controlador de vídeo VA-API o no funciona. Amb gràfics Intel, "
"instal·leu intel-media-driver (RPM Fusion nonfree) i torneu-ho a provar."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"El codificador de vídeo no s'ha iniciat. Pot ser que al controlador gràfic "
"li falti la codificació de vídeo per maquinari (VA-API o NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s no és un lloc segur per a l'estat de l'enregistrament"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "L'enregistrament s'ha aturat"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "No s'ha trobat la sortida de so que cal enregistrar"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "No s'ha pogut iniciar l'enregistrament"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "No s'ha pogut crear la carpeta %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s no està instal·lat"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s no s'ha iniciat"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "No s'ha pogut iniciar l'enregistrament (registre: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Enregistrament desat"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "L'enregistrament pot estar incomplet"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"El punt vermell parpellejant sobre un vídeo a pantalla completa està "
"activat. Si encara no el veieu, tanqueu la sessió i torneu-la a iniciar una "
"vegada. Podeu desactivar-lo a l'aplicació Extensions."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Enregistra pantalla i so"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Enregistra només la pantalla"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Enregistra només el so"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Posa en pausa o reprèn l'enregistrament"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Enregistra la pantalla i el so de l'escriptori amb dreceres de teclat"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Enregistrador de pantalla i so amb dreceres de teclat"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Una tecla enregistra la pantalla i el so de l'escriptori, una altra només la "
"pantalla, una altra només el so com a MP3. La mateixa tecla atura i desa "
"l'enregistrament; una quarta el posa en pausa i el reprèn."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Les tecles funcionen en qualsevol finestra, també a Wayland. Un punt vermell "
"a la barra superior indica que s'està enregistrant, un de groc que està en "
"pausa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"La pantalla l'enregistra el maquinari gràfic. La carpeta, el format del "
"fitxer i les taxes de bits s'estableixen en un fitxer de configuració "
"senzill."
