#: hotrec/cli.py
msgid "Could not set the keyboard shortcuts"
msgstr "Níorbh fhéidir na aicearraí méarchláir a shocrú"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Tá na haicearraí méarchláir socraithe"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: scáileán agus fuaim. Ctrl+Shift+F10: scáileán amháin. "
"Ctrl+Shift+F11: fuaim amháin. Ctrl+Shift+F12: sos nó athtosú. Stopann agus "
"sábhálann ceann ar bith de na chéad trí cinn an taifeadadh."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Ar sos"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Lean ar aghaidh"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Ag taifeadadh"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Sos"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Stop agus sábháil"

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "Ní áit shábháilte é %s do staid an taifeadta"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Níor aimsíodh an t-aschur fuaime le taifeadadh"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Níorbh fhéidir an taifeadadh a thosú"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Níorbh fhéidir an fillteán %s a chruthú"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "Níl %s suiteáilte"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "Níor thosaigh %s"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Níorbh fhéidir an taifeadadh a thosú (logchomhad: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Taifeadadh sábháilte"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "D'fhéadfadh an taifeadadh a bheith neamhiomlán"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Taifead scáileán agus fuaim"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Taifead scáileán amháin"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Taifead fuaim amháin"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Cuir an taifeadadh ar sos nó lean air"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Taifeadann scáileán agus fuaim an deisce le haicearraí méarchláir"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Taifeadán scáileáin agus fuaime le haicearraí méarchláir"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Taifeadann eochair amháin scáileán agus fuaim an deisce, eochair eile an "
"scáileán amháin, ceann eile an fhuaim amháin mar MP3. Stopann agus sábhálann "
"an eochair chéanna an taifeadadh; cuireann an ceathrú ceann ar sos é agus "
"leanann air."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Oibríonn na heochracha i ngach fuinneog, fiú faoi Wayland. Léiríonn poncán "
"dearg sa bharra uachtair go bhfuil taifeadadh ar siúl, ceann buí go bhfuil "
"sé ar sos."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Taifeadann crua-earraí grafaice an scáileán. Socraítear an fillteán, formáid "
"an chomhaid agus na ráta giotán i gcomhad socruithe simplí."
