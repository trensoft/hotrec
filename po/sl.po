#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Bližnjic na tipkovnici ni bilo mogoče nastaviti"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Bližnjice na tipkovnici so nastavljene"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: zaslon in zvok. Ctrl+Shift+F10: samo zaslon. Ctrl+Shift+F11: "
"samo zvok. Ctrl+Shift+F12: premor ali nadaljevanje. Katera koli od prvih "
"treh ustavi in shrani posnetek."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Zaustavljeno"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Nadaljuj"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Snemanje"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Premor"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Ustavi in shrani"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Nastavi bližnjice na tipkovnici..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Bližnjice na tipkovnici"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Kliknite polje in pritisnite nove tipke. Esc prekliče."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Shrani videe v"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Shrani zvok v"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Privzeto"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Shrani"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Izberi mapo"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Map ni bilo mogoče shraniti"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Pritisnite tipke..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Uporabite Ctrl, Alt ali Super skupaj s tipko."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dve bližnjici imata enaki tipki."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Video gonilnik VA-API manjka ali ne deluje. Pri grafiki Intel namestite "
"intel-media-driver (RPM Fusion nonfree) in poskusite znova."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Video kodirnik se ni zagnal. Grafičnemu gonilniku morda manjka strojno "
"kodiranje videa (VA-API ali NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s ni varno mesto za stanje snemanja"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Snemanje se je ustavilo"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Zvočni izhod za snemanje ni bil najden"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Snemanja ni bilo mogoče začeti"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Mape %s ni bilo mogoče ustvariti"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s ni nameščen"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s se ni zagnal"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Snemanja ni bilo mogoče začeti (dnevnik: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Posnetek shranjen"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Posnetek je morda nepopoln"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Utripajoča rdeča pika nad videom čez cel zaslon je vklopljena. Če je še ne "
"vidite, se enkrat odjavite in znova prijavite. Izklopite jo lahko v "
"aplikaciji Razširitve."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Snemaj zaslon in zvok"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Snemaj samo zaslon"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Snemaj samo zvok"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Premor ali nadaljevanje snemanja"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Snema zaslon in zvok namizja z bližnjicami na tipkovnici"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Snemalnik zaslona in zvoka z bližnjicami na tipkovnici"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Ena tipka snema zaslon in zvok namizja, druga samo zaslon, tretja samo zvok "
"kot MP3. Ista tipka ustavi in shrani posnetek; četrta ga začasno ustavi in "
"nadaljuje."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tipke delujejo v vsakem oknu, tudi v Waylandu. Rdeča pika v zgornji vrstici "
"kaže, da snemanje poteka, rumena, da je zaustavljeno."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Zaslon snema grafična strojna oprema. Mapa, oblika datoteke in bitne "
"hitrosti se nastavijo v preprosti datoteki z nastavitvami."
