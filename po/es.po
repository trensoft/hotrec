#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "No se pudieron establecer los atajos de teclado"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Los atajos de teclado están establecidos"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Mayús+F9: pantalla y sonido. Ctrl+Mayús+F10: solo pantalla. "
"Ctrl+Mayús+F11: solo sonido. Ctrl+Mayús+F12: pausar o reanudar. Cualquiera "
"de los tres primeros detiene y guarda la grabación."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Mayús+F7: área y sonido. Ctrl+Mayús+F8: solo área. Ambas también "
"detienen y guardan la grabación."

#: hotrec/indicator.py
msgid "Paused"
msgstr "En pausa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Reanudar"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Grabando"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pausar"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Detener y guardar"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Establecer atajos de teclado..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Atajos de teclado"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Haga clic en un campo y pulse las teclas nuevas. Esc cancela."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Guardar los vídeos en"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Guardar el audio en"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Predeterminada"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Guardar"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Elegir una carpeta"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "No se pudieron guardar las carpetas"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Pulse las teclas..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Use Ctrl, Alt o Super junto con la tecla."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dos de los atajos tienen las mismas teclas."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Falta el controlador de vídeo VA-API o no funciona. Con gráficos Intel, "
"instale intel-media-driver (RPM Fusion nonfree) y vuelva a intentarlo."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"El codificador de vídeo no se inició. Puede que al controlador gráfico le "
"falte la codificación de vídeo por hardware (VA-API o NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s no es un lugar seguro para el estado de la grabación"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "La grabación se detuvo"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "No se pudo iniciar la grabación"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "La ventana para elegir el área no se inició"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "No se encontró la salida de sonido que grabar"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "No se pudo crear la carpeta %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s no está instalado"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s no se inició"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "No se pudo iniciar la grabación (registro: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Grabación guardada, pero no se pudo recortar el área: se incluye toda la "
"pantalla"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Grabación guardada"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Solo la vista se recorta al área: el resto de la pantalla permanece en el "
"archivo"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Es posible que la grabación esté incompleta"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Arrastre el área que desea grabar. Esc o el botón derecho cancela."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"El punto rojo parpadeante sobre un vídeo a pantalla completa está activado. "
"Puede desactivarlo en la aplicación Extensiones."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"El punto rojo parpadeante sobre un vídeo a pantalla completa está activado. "
"Si todavía no lo ve, cierre sesión y vuelva a iniciarla una vez. Puede "
"desactivarlo en la aplicación Extensiones."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Grabar área y sonido"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Grabar solo el área"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Grabar pantalla y sonido"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Grabar solo la pantalla"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Grabar solo el sonido"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pausar o reanudar la grabación"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Graba la pantalla y el sonido del escritorio con atajos de teclado"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Grabador de pantalla y sonido con atajos de teclado"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Una tecla graba la pantalla y el sonido del escritorio, otra solo la "
"pantalla, otra solo el sonido como MP3. La misma tecla detiene y guarda la "
"grabación; una cuarta tecla la pausa y la reanuda."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Las teclas funcionan en cualquier ventana, también en Wayland. Un punto rojo "
"en la barra superior indica que se está grabando, uno amarillo que la "
"grabación está en pausa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"La pantalla la graba el hardware gráfico. La carpeta, el formato del archivo "
"y las tasas de bits se establecen en un archivo de configuración sencillo."
