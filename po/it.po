#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Impossibile impostare le scorciatoie da tastiera"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Le scorciatoie da tastiera sono impostate"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Maiusc+F9: schermo e audio. Ctrl+Maiusc+F10: solo schermo. "
"Ctrl+Maiusc+F11: solo audio. Ctrl+Maiusc+F12: pausa o ripresa. Una qualsiasi "
"delle prime tre ferma e salva la registrazione."

#: hotrec/indicator.py
msgid "Paused"
msgstr "In pausa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Riprendi"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Registrazione"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pausa"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Ferma e salva"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Imposta scorciatoie da tastiera..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Scorciatoie da tastiera"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Fai clic su un campo, poi premi i nuovi tasti. Esc annulla."

#: hotrec/keys_window.py
msgid "Save"
msgstr "Salva"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Premi i tasti..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Usa Ctrl, Alt o Super insieme al tasto."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Due scorciatoie hanno gli stessi tasti."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s non è un posto sicuro per lo stato della registrazione"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Uscita audio da registrare non trovata"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Impossibile avviare la registrazione"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Impossibile creare la cartella %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s non è installato"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s non si è avviato"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Impossibile avviare la registrazione (log: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Registrazione salvata"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "La registrazione potrebbe essere incompleta"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Registra schermo e audio"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Registra solo lo schermo"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Registra solo l'audio"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Metti in pausa o riprendi la registrazione"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Registra lo schermo e l'audio del desktop con scorciatoie da tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Registratore di schermo e audio con scorciatoie da tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Un tasto registra lo schermo e l'audio del desktop, un altro solo lo "
"schermo, un altro solo l'audio in MP3. Lo stesso tasto ferma e salva la "
"registrazione; un quarto tasto la mette in pausa e la riprende."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"I tasti funzionano in ogni finestra, anche su Wayland. Un punto rosso nella "
"barra superiore indica che la registrazione è in corso, uno giallo che è in "
"pausa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Lo schermo viene registrato dall'hardware grafico. La cartella, il formato "
"del file e i bitrate si impostano in un semplice file di configurazione."
