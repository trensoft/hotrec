#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Klávesové zkratky se nepodařilo nastavit"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Klávesové zkratky jsou nastaveny"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: obrazovka a zvuk. Ctrl+Shift+F10: jen obrazovka. "
"Ctrl+Shift+F11: jen zvuk. Ctrl+Shift+F12: pozastavit nebo pokračovat. "
"Kterákoli z prvních tří záznam zastaví a uloží."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Pozastaveno"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Pokračovat"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Nahrávání"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pozastavit"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Zastavit a uložit"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Nastavit klávesové zkratky..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Klávesové zkratky"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klepněte na pole a stiskněte nové klávesy. Esc zruší."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Ukládat videa do"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Ukládat zvuk do"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Výchozí"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Uložit"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Vybrat složku"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Složky se nepodařilo uložit"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Stiskněte klávesy..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Použijte Ctrl, Alt nebo Super spolu s klávesou."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dvě zkratky mají stejné klávesy."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Videoovladač VA-API chybí nebo nefunguje. U grafiky Intel nainstalujte intel-"
"media-driver (RPM Fusion nonfree) a zkuste to znovu."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Videokodér se nespustil. Grafickému ovladači možná chybí hardwarové kódování "
"videa (VA-API nebo NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s není bezpečné místo pro stav nahrávání"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Nahrávání se zastavilo"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Nahrávání se nepodařilo spustit"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Okno pro výběr oblasti se nespustilo"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Zvukový výstup k nahrávání nebyl nalezen"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Složku %s se nepodařilo vytvořit"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s není nainstalován"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s se nespustil"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Nahrávání se nepodařilo spustit (protokol: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Nahrávka uložena, ale oblast se nepodařilo vyříznout: je v ní celá obrazovka"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Nahrávka uložena"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Nahrávka může být neúplná"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Tažením vyberte oblast k nahrání. Esc nebo pravé tlačítko akci zruší."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Blikající červená tečka nad videem na celou obrazovku je zapnutá. Vypnout ji "
"můžete v aplikaci Rozšíření."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Blikající červená tečka nad videem na celou obrazovku je zapnutá. Pokud ji "
"ještě nevidíte, jednou se odhlaste a znovu přihlaste. Vypnout ji můžete v "
"aplikaci Rozšíření."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Nahrát oblast a zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Nahrát jen oblast"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Nahrát obrazovku a zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Nahrát jen obrazovku"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Nahrát jen zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pozastavit nebo obnovit nahrávání"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Nahrává obrazovku a zvuk plochy pomocí klávesových zkratek"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Záznam obrazovky a zvuku s klávesovými zkratkami"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Jedna klávesa nahrává obrazovku a zvuk plochy, jiná jen obrazovku, další jen "
"zvuk jako MP3. Táž klávesa nahrávání zastaví a uloží; čtvrtá je pozastaví a "
"znovu spustí."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Klávesy fungují v každém okně, i ve Waylandu. Červená tečka na horní liště "
"značí, že nahrávání běží, žlutá, že je pozastaveno."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Obrazovku nahrává grafický hardware. Složka, formát souboru a datové toky se "
"nastavují v jednoduchém konfiguračním souboru."
