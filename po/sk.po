#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "O programe"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Verzia %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "Záznamník obrazovky a zvuku pre GNOME, ovládaný klávesovými skratkami."

#: hotrec/about_window.py
msgid "Website"
msgstr "Webová stránka"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Nahlásiť problém"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licencia: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Zavrieť"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Klávesové skratky sa nepodarilo nastaviť"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Klávesové skratky sú nastavené"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: obrazovka a zvuk. Ctrl+Shift+F10: len obrazovka. "
"Ctrl+Shift+F11: len zvuk. Ctrl+Shift+F12: pozastaviť alebo pokračovať. "
"Ktorákoľvek z prvých troch nahrávku zastaví a uloží."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: oblasť a zvuk. Ctrl+Shift+F8: len oblasť. Obe tiež zastavia a "
"uložia nahrávku."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Pozastavené"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Pokračovať"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Nahráva sa"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pozastaviť"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Zastaviť a uložiť"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Nastavenia…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Videoovládač VA-API chýba alebo nefunguje. Pri grafike Intel nainštalujte "
"intel-media-driver (RPM Fusion nonfree) a skúste to znova."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Videokodér sa nespustil. Grafickému ovládaču možno chýba hardvérové "
"kódovanie videa (VA-API alebo NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s nie je bezpečné miesto pre stav nahrávania"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Nahrávanie sa zastavilo"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Nahrávanie sa nepodarilo spustiť"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Okno na výber oblasti sa nespustilo"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Zvukový výstup na nahrávanie sa nenašiel"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Priečinok %s sa nepodarilo vytvoriť"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s nie je nainštalovaný"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s sa nespustil"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Nahrávanie sa nepodarilo spustiť (záznam: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Nahrávka uložená, ale oblasť sa nepodarilo vystrihnúť: je v nej celá "
"obrazovka"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Nahrávka uložená"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr "Orezané je iba zobrazenie na oblasť: zvyšok obrazovky zostáva v súbore"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Nahrávka môže byť neúplná"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Ťahaním vyberte oblasť na nahrávanie. Esc alebo pravé tlačidlo zruší výber."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Nastavenia"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Obnoviť predvolené"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Klávesové skratky"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Kliknite na pole a stlačte nové klávesy. Esc zruší."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Video kodek"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (prehrá sa všade)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (približne polovičná veľkosť súboru)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Dátový tok videa"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Snímková frekvencia"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Formát videosúboru"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 nie je k dispozícii: grafická karta ho nevie kódovať."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"Videá H.265 môžu na prehrávanie v systéme Windows a v niektorých "
"prehliadačoch vyžadovať dodatočný kodek."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Zvuk"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Zvukový kodek pre nahrávky iba so zvukom"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Dátový tok zvuku s videom"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Dátový tok zvuku pre nahrávky iba so zvukom"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr "Platí len pre nahrávky iba so zvukom. Pri videu je zvuk vždy AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Priečinky"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Videá sa ukladajú do"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Zvukové nahrávky sa ukladajú do"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Vybrať…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Vybrať priečinok"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Stlačte klávesy..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Použite Ctrl, Alt alebo Super spolu s klávesom."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dve skratky majú rovnaké klávesy."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Obnoviť všetky nastavenia na predvolené hodnoty?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Blikajúci červený bod nad videom na celej obrazovke je zapnutý. Vypnúť ho "
"môžete v aplikácii Rozšírenia."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Blikajúci červený bod nad videom na celej obrazovke je zapnutý. Ak ho ešte "
"nevidíte, raz sa odhláste a znova prihláste. Vypnúť ho môžete v aplikácii "
"Rozšírenia."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Nahrať oblasť a zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Nahrať len oblasť"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Nahrať obrazovku a zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Nahrať len obrazovku"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Nahrať len zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pozastaviť alebo obnoviť nahrávanie"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Nahráva obrazovku a zvuk pracovnej plochy pomocou klávesových skratiek"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Nahrávač obrazovky a zvuku s klávesovými skratkami"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Jedna klávesa nahráva obrazovku a zvuk pracovnej plochy, iná len obrazovku, "
"ďalšia len zvuk ako MP3. Tá istá klávesa nahrávanie zastaví a uloží; štvrtá "
"ho pozastaví a znova spustí."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Klávesy fungujú v každom okne, aj vo Waylande. Červená bodka na hornej lište "
"označuje, že nahrávanie beží, žltá, že je pozastavené."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Obrazovku nahráva grafický hardvér. Priečinok, formát súboru a dátové toky "
"sa nastavujú v jednoduchom konfiguračnom súbore."
