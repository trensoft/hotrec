#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Não foi possível definir os atalhos de teclado"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Os atalhos de teclado estão definidos"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: ecrã e som. Ctrl+Shift+F10: só ecrã. Ctrl+Shift+F11: só som. "
"Ctrl+Shift+F12: pausar ou retomar. Qualquer um dos três primeiros pára e "
"guarda a gravação."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Em pausa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Retomar"

#: hotrec/indicator.py
msgid "Recording"
msgstr "A gravar"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pausar"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Parar e guardar"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Definir atalhos de teclado..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Atalhos de teclado"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Clique num campo e prima as novas teclas. Esc cancela."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Guardar os vídeos em"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Guardar o áudio em"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Predefinição"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Guardar"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Escolher uma pasta"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Não foi possível guardar as pastas"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Prima as teclas..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Use Ctrl, Alt ou Super juntamente com a tecla."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dois atalhos têm as mesmas teclas."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"O controlador de vídeo VA-API não existe ou não funciona. Com gráficos "
"Intel, instale o intel-media-driver (RPM Fusion nonfree) e tente novamente."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"O codificador de vídeo não arrancou. O controlador gráfico pode não ter "
"codificação de vídeo por hardware (VA-API ou NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s não é um local seguro para o estado da gravação"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "A gravação parou"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Não foi possível iniciar a gravação"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "A janela para escolher a área não foi iniciada"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "A saída de som a gravar não foi encontrada"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Não foi possível criar a pasta %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s não está instalado"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s não arrancou"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Não foi possível iniciar a gravação (registo: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Gravação guardada, mas não foi possível recortar a área: está lá o ecrã "
"inteiro"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Gravação guardada"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "A gravação pode estar incompleta"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Arraste para escolher a área a gravar. Esc ou o botão direito cancela."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"O ponto vermelho intermitente sobre um vídeo em ecrã completo está ativado. "
"Pode desativá-lo na aplicação Extensões."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"O ponto vermelho intermitente sobre um vídeo em ecrã completo está ativado. "
"Se ainda não o vir, termine a sessão e inicie-a novamente uma vez. Pode "
"desativá-lo na aplicação Extensões."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Gravar área e som"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Gravar só a área"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Gravar ecrã e som"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Gravar só o ecrã"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Gravar só o som"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pausar ou retomar a gravação"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Grava o ecrã e o som do ambiente de trabalho com atalhos de teclado"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Gravador de ecrã e som com atalhos de teclado"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Uma tecla grava o ecrã e o som do ambiente de trabalho, outra só o ecrã, "
"outra só o som em MP3. A mesma tecla pára e guarda a gravação; uma quarta "
"pausa-a e retoma-a."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"As teclas funcionam em qualquer janela, também no Wayland. Um ponto vermelho "
"na barra superior indica que há uma gravação em curso, um amarelo que está "
"em pausa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"O ecrã é gravado pelo hardware gráfico. A pasta, o formato do ficheiro e as "
"taxas de bits definem-se num ficheiro de definições simples."
