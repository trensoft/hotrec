#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Nem sikerült beállítani a billentyűparancsokat"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "A billentyűparancsok be vannak állítva"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: képernyő és hang. Ctrl+Shift+F10: csak a képernyő. "
"Ctrl+Shift+F11: csak a hang. Ctrl+Shift+F12: szünet vagy folytatás. Az első "
"három bármelyike leállítja és menti a felvételt."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: terület és hang. Ctrl+Shift+F8: csak a terület. Mindkettő le "
"is állítja és el is menti a felvételt."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Szünetel"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Folytatás"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Felvétel"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Szünet"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Leállítás és mentés"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Billentyűparancsok beállítása..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Billentyűparancsok"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr ""
"Kattintson egy mezőre, majd nyomja le az új billentyűket. Az Esc megszakítja."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Videók mentése ide"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Hangfelvételek mentése ide"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Alapértelmezett"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Mentés"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Mappa kiválasztása"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "A mappák nem menthetők"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Nyomja le a billentyűket..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Használjon Ctrl, Alt vagy Super billentyűt a billentyűvel együtt."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Két billentyűparancs ugyanazokat a billentyűket használja."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"A VA-API videóillesztő hiányzik, vagy nem működik. Intel grafika esetén "
"telepítse az intel-media-driver csomagot (RPM Fusion nonfree), majd próbálja "
"újra."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"A videókódoló nem indult el. Lehet, hogy a grafikus illesztőprogramból "
"hiányzik a hardveres videókódolás (VA-API vagy NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "A(z) %s nem biztonságos hely a felvétel állapotának"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "A felvétel leállt"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "A felvétel nem indult el"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "A terület kiválasztására szolgáló ablak nem indult el"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Nem található a felveendő hangkimenet"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "A(z) %s mappa nem hozható létre"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "A(z) %s nincs telepítve"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "A(z) %s nem indult el"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "A felvétel nem indult el (napló: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"A felvétel mentve, de a területet nem lehetett kivágni: a teljes képernyő "
"benne van"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "A felvétel mentve"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Csak a nézet van a területre vágva: a képernyő többi része a fájlban marad"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "A felvétel hiányos lehet"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Húzza ki a felveendő területet. Az Esc vagy a jobb gomb megszakítja."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"A teljes képernyős videó fölött villogó piros pötty be van kapcsolva. A "
"Bővítmények alkalmazásban kikapcsolhatja."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"A teljes képernyős videó fölött villogó piros pötty be van kapcsolva. Ha még "
"nem látja, jelentkezzen ki, majd be egyszer. A Bővítmények alkalmazásban "
"kikapcsolhatja."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Terület és hang felvétele"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Csak a terület felvétele"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Képernyő és hang felvétele"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Csak a képernyő felvétele"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Csak a hang felvétele"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "A felvétel szüneteltetése vagy folytatása"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Az asztal képernyőjének és hangjának felvétele billentyűparancsokkal"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Képernyő- és hangfelvevő billentyűparancsokkal"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Az egyik billentyű az asztal képernyőjét és hangját veszi fel, a másik csak "
"a képernyőt, a harmadik csak a hangot MP3-ként. Ugyanaz a billentyű "
"leállítja és menti a felvételt; a negyedik szünetelteti, majd folytatja."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"A billentyűk minden ablakban működnek, Waylanden is. A felső sávban a piros "
"pont azt jelzi, hogy felvétel fut, a sárga azt, hogy szünetel."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"A képernyőt a grafikus hardver rögzíti. A mappát, a fájlformátumot és a "
"bitrátákat egy egyszerű beállításfájl tartalmazza."
