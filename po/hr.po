#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "O programu"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Inačica %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "Snimač zaslona i zvuka za GNOME, upravljan prečacima tipkovnice."

#: hotrec/about_window.py
msgid "Website"
msgstr "Web stranica"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Prijavi problem"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licenca: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Zatvori"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Prečace tipkovnice nije bilo moguće postaviti"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Prečaci tipkovnice su postavljeni"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: zaslon i zvuk. Ctrl+Shift+F10: samo zaslon. Ctrl+Shift+F11: "
"samo zvuk. Ctrl+Shift+F12: pauziraj ili nastavi. Bilo koji od prva tri "
"zaustavlja i sprema snimku."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: područje i zvuk. Ctrl+Shift+F8: samo područje. Obje i "
"zaustavljaju i spremaju snimku."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Pauzirano"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Nastavi"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Snimanje"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pauziraj"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Zaustavi i spremi"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Postavke…"

#: hotrec/indicator.py
msgid "Quit"
msgstr "Izlaz"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Videodriver VA-API nedostaje ili ne radi. Uz Intelovu grafiku instalirajte "
"intel-media-driver (RPM Fusion nonfree) i pokušajte ponovno."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Video koder nije pokrenut. Grafičkom upravljačkom programu možda nedostaje "
"hardversko kodiranje videa (VA-API ili NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s nije sigurno mjesto za stanje snimanja"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Snimanje je zaustavljeno"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Snimanje nije moguće pokrenuti"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Prozor za odabir područja nije pokrenut"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Zvučni izlaz za snimanje nije pronađen"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Mapu %s nije moguće stvoriti"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s nije instaliran"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s se nije pokrenuo"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Snimanje nije moguće pokrenuti (zapisnik: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Snimka je spremljena, ali područje nije bilo moguće izrezati: u njoj je "
"cijeli zaslon"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Snimka je spremljena"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr "Samo se prikaz izrezuje na područje: ostatak zaslona ostaje u datoteci"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Snimka je možda nepotpuna"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Povucite za odabir područja za snimanje. Esc ili desna tipka poništava."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Postavke"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Vrati na zadano"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Prečaci tipkovnice"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Kliknite polje, zatim pritisnite nove tipke. Esc poništava."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Video kodek"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (reproducira se svugdje)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (otprilike upola manja datoteka)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Video brzina prijenosa"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Broj sličica u sekundi"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Format video datoteke"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 nije dostupan: grafička kartica ga ne može kodirati."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"H.265 videozapisi možda trebaju dodatni kodek za reprodukciju na sustavu "
"Windows i u nekim preglednicima."

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr "Snimke područja uvijek su H.264, čak i kada je odabran H.265."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Zvuk"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Zvučni kodek za snimanja samo zvuka"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Zvučna brzina prijenosa s videom"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Zvučna brzina prijenosa za snimanja samo zvuka"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"Primjenjuje se samo na snimanja samo zvuka. S videom, zvuk je uvijek AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Mape"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Videozapisi se spremaju u"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Zvučne snimke se spremaju u"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Odaberi…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Odaberi mapu"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Pritisnite tipke..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Koristite Ctrl, Alt ili Super zajedno s tipkom."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dva prečaca imaju iste tipke."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Vratiti svaku postavku na zadanu vrijednost?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Treperava crvena točka iznad videa na cijelom zaslonu je uključena. Možete "
"je isključiti u aplikaciji Proširenja."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Treperava crvena točka iznad videa na cijelom zaslonu je uključena. Ako je "
"još ne vidite, jednom se odjavite i ponovno prijavite. Možete je isključiti "
"u aplikaciji Proširenja."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Snimi područje i zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Snimi samo područje"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Snimi zaslon i zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Snimi samo zaslon"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Snimi samo zvuk"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pauziraj ili nastavi snimanje"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Snima zaslon i zvuk radne površine pomoću prečaca tipkovnice"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Snimač zaslona i zvuka s prečacima tipkovnice"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Jedna tipka snima zaslon i zvuk radne površine, druga samo zaslon, treća "
"samo zvuk kao MP3. Ista tipka zaustavlja i sprema snimku; četvrta je pauzira "
"i nastavlja."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tipke rade u svakom prozoru, i pod Waylandom. Crvena točka u gornjoj traci "
"pokazuje da snimanje traje, žuta da je pauzirano."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Zaslon snima grafički hardver. Mapa, format datoteke i brzine prijenosa "
"postavljaju se u jednostavnoj datoteci postavki."
