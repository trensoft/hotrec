#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "De sneltoetsen konden niet worden ingesteld"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "De sneltoetsen zijn ingesteld"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: scherm en geluid. Ctrl+Shift+F10: alleen scherm. "
"Ctrl+Shift+F11: alleen geluid. Ctrl+Shift+F12: pauzeren of hervatten. Elk "
"van de eerste drie stopt en bewaart de opname."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Gepauzeerd"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Hervatten"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Opname loopt"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pauzeren"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Stoppen en opslaan"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Sneltoetsen instellen..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Sneltoetsen"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klik op een veld en druk dan op de nieuwe toetsen. Esc annuleert."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Video's opslaan in"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Audio opslaan in"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Standaard"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Opslaan"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Kies een map"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "De mappen konden niet worden opgeslagen"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Druk op de toetsen..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Gebruik Ctrl, Alt of Super samen met de toets."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Twee sneltoetsen hebben dezelfde toetsen."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Het VA-API-videostuurprogramma ontbreekt of werkt niet. Installeer bij Intel-"
"graphics intel-media-driver (RPM Fusion nonfree) en probeer het opnieuw."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"De videoencoder is niet gestart. Het grafische stuurprogramma mist mogelijk "
"hardwarematige videocodering (VA-API of NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s is geen veilige plek voor de status van de opname"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "De opname is gestopt"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "De op te nemen geluidsuitgang is niet gevonden"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "De opname kon niet worden gestart"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "De map %s kon niet worden aangemaakt"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s is niet geïnstalleerd"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s is niet gestart"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "De opname kon niet worden gestart (logboek: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Opname opgeslagen"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "De opname is mogelijk onvolledig"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Scherm en geluid opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Alleen scherm opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Alleen geluid opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Opname pauzeren of hervatten"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Neemt het scherm en het geluid van het bureaublad op met sneltoetsen"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Scherm- en geluidsrecorder met sneltoetsen"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Eén toets neemt het scherm en het geluid van het bureaublad op, een andere "
"alleen het scherm, een derde alleen het geluid als MP3. Dezelfde toets stopt "
"en bewaart de opname; een vierde pauzeert en hervat haar."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"De toetsen werken in elk venster, ook onder Wayland. Een rode stip in de "
"bovenbalk toont dat een opname loopt, een gele dat ze gepauzeerd is."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Het scherm wordt opgenomen door de grafische hardware. De map, het "
"bestandsformaat en de bitsnelheden stel je in met een eenvoudig "
"instellingenbestand."
