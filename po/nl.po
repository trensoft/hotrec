#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "Info"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Versie %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "Scherm- en geluidsrecorder voor GNOME, bediend met sneltoetsen."

#: hotrec/about_window.py
msgid "Website"
msgstr "Website"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Een probleem melden"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licentie: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Sluiten"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "De sneltoetsen konden niet worden ingesteld"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "De sneltoetsen zijn ingesteld"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: scherm en geluid. Ctrl+Shift+F10: alleen scherm. "
"Ctrl+Shift+F11: alleen geluid. Ctrl+Shift+F12: pauzeren of hervatten. Elk "
"van de eerste drie stopt en bewaart de opname."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: gebied en geluid. Ctrl+Shift+F8: alleen gebied. Beide stoppen "
"de opname ook en slaan die op."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Gepauzeerd"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Hervatten"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Opname loopt"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pauzeren"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Stoppen en opslaan"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Instellingen…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Het VA-API-videostuurprogramma ontbreekt of werkt niet. Installeer bij Intel-"
"graphics intel-media-driver (RPM Fusion nonfree) en probeer het opnieuw."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"De videoencoder is niet gestart. Het grafische stuurprogramma mist mogelijk "
"hardwarematige videocodering (VA-API of NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s is geen veilige plek voor de status van de opname"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "De opname is gestopt"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "De opname kon niet worden gestart"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Het venster voor het kiezen van het gebied is niet gestart"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "De op te nemen geluidsuitgang is niet gevonden"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "De map %s kon niet worden aangemaakt"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s is niet geïnstalleerd"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s is niet gestart"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "De opname kon niet worden gestart (logboek: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Opname opgeslagen, maar het gebied kon niet worden uitgesneden: het hele "
"scherm staat erin"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Opname opgeslagen"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Alleen de weergave wordt bijgesneden tot het gebied: de rest van het scherm "
"blijft in het bestand"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "De opname is mogelijk onvolledig"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Sleep het gebied dat u wilt opnemen. Esc of de rechtermuisknop annuleert."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Instellingen"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Herstellen naar standaardwaarden"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Sneltoetsen"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klik op een veld en druk dan op de nieuwe toetsen. Esc annuleert."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Videocodec"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (speelt overal af)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (ongeveer de helft van de bestandsgrootte)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Videobitrate"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Framerate"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Videobestandsformaat"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 is niet beschikbaar: de grafische kaart kan dit niet coderen."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"H.265-video's hebben mogelijk een extra codec nodig om in Windows en sommige "
"browsers af te spelen."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Geluid"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Geluidscodec voor alleen-geluid-opnames"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Geluidsbitrate met video"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Geluidsbitrate voor alleen-geluid-opnames"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"Geldt alleen voor alleen-geluid-opnames. Met video is het geluid altijd AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Mappen"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Video's worden opgeslagen in"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Geluidsopnames worden opgeslagen in"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Kiezen…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Kies een map"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Druk op de toetsen..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Gebruik Ctrl, Alt of Super samen met de toets."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Twee sneltoetsen hebben dezelfde toetsen."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Elke instelling herstellen naar de standaardwaarde?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"De knipperende rode stip boven een video op volledig scherm staat aan. U "
"kunt hem uitschakelen in de app Extensies."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"De knipperende rode stip boven een video op volledig scherm staat aan. Als u "
"hem nog niet ziet, meld u dan één keer af en weer aan. U kunt hem "
"uitschakelen in de app Extensies."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Gebied en geluid opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Alleen gebied opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Scherm en geluid opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Alleen scherm opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Alleen geluid opnemen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Opname pauzeren of hervatten"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Neemt het scherm en het geluid van het bureaublad op met sneltoetsen"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Scherm- en geluidsrecorder met sneltoetsen"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Eén toets neemt het scherm en het geluid van het bureaublad op, een andere "
"alleen het scherm, een derde alleen het geluid als MP3. Dezelfde toets stopt "
"en bewaart de opname; een vierde pauzeert en hervat haar."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"De toetsen werken in elk venster, ook onder Wayland. Een rode stip in de "
"bovenbalk toont dat een opname loopt, een gele dat ze gepauzeerd is."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Het scherm wordt opgenomen door de grafische hardware. De map, het "
"bestandsformaat en de bitsnelheden stel je in met een eenvoudig "
"instellingenbestand."
