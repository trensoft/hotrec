#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "Teave"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Versioon %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "Ekraani- ja helisalvesti GNOME'ile, mida juhitakse kiirklahvidega."

#: hotrec/about_window.py
msgid "Website"
msgstr "Veebileht"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Teata probleemist"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Litsents: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Sulge"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Kiirklahve ei õnnestunud seada"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Kiirklahvid on seatud"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: ekraan ja heli. Ctrl+Shift+F10: ainult ekraan. "
"Ctrl+Shift+F11: ainult heli. Ctrl+Shift+F12: peata või jätka. Mis tahes "
"esimesest kolmest peatab ja salvestab lindistuse."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: ala ja heli. Ctrl+Shift+F8: ainult ala. Mõlemad peatavad ja "
"salvestavad ka lindistuse."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Peatatud"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Jätka"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Lindistamine"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Peata"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Lõpeta ja salvesta"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Sätted…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API videodraiver puudub või ei tööta. Inteli graafika korral paigaldage "
"intel-media-driver (RPM Fusion nonfree) ja proovige uuesti."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Videokodeerija ei käivitunud. Graafikadraiveril võib puududa riistvaraline "
"videokodeerimine (VA-API või NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s ei ole lindistuse oleku jaoks turvaline koht"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Salvestus peatus"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Lindistamist ei õnnestunud alustada"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Ala valimise aken ei käivitunud"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Lindistatavat heliväljundit ei leitud"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Kausta %s ei õnnestunud luua"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s ei ole paigaldatud"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s ei käivitunud"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Lindistamist ei õnnestunud alustada (logi: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Lindistus salvestatud, kuid ala lõikamine ei õnnestunud: sees on kogu ekraan"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Lindistus salvestatud"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr "Ainult vaade lõigatakse alale: ülejäänud ekraan jääb faili"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Lindistus võib olla poolik"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Lohistage lindistatav ala. Esc või parem nupp tühistab."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Sätted"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Taasta algseaded"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Kiirklahvid"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klõpsake väljal ja vajutage uusi klahve. Esc tühistab."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Videokoodek"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (mängitav kõikjal)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (umbes poole väiksem fail)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Video bitikiirus"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Kaadrisagedus"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Videofaili vorming"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 pole saadaval: graafikakaart ei suuda seda kodeerida."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"H.265 videod võivad Windowsis ja mõnedes brauserites vajada esitamiseks "
"lisakoodekit."

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr "Piirkonna salvestused on alati H.264, isegi kui H.265 on valitud."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Heli"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Helikoodek ainult heliga salvestustele"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Heli bitikiirus videoga"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Heli bitikiirus ainult heliga salvestustele"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"Kehtib ainult ainult heliga salvestustele. Video puhul on heli alati AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Kaustad"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Videod salvestatakse asukohta"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Helisalvestised salvestatakse asukohta"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Vali…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Vali kaust"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Vajutage klahve..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Kasutage klahviga koos Ctrl-, Alt- või Super-klahvi."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Kahel kiirklahvil on samad klahvid."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Kas taastada kõikide sätete algväärtused?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Täisekraanvideo kohal vilkuv punane täpp on sisse lülitatud. Selle saab "
"välja lülitada rakenduses Laiendused."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Täisekraanvideo kohal vilkuv punane täpp on sisse lülitatud. Kui te seda "
"veel ei näe, logige korra välja ja uuesti sisse. Selle saab välja lülitada "
"rakenduses Laiendused."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Lindista ala ja heli"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Lindista ainult ala"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Lindista ekraan ja heli"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Lindista ainult ekraan"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Lindista ainult heli"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Peata või jätka lindistamist"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Lindistab töölaua ekraani ja heli kiirklahvidega"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Ekraani- ja helilindistaja kiirklahvidega"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Üks klahv lindistab töölaua ekraani ja heli, teine ainult ekraani, kolmas "
"ainult heli MP3-na. Sama klahv peatab lindistuse ja salvestab selle; neljas "
"peatab ajutiselt ja jätkab."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Klahvid töötavad igas aknas, ka Waylandis. Punane täpp ülaribal näitab, et "
"lindistus käib, kollane, et see on peatatud."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Ekraani lindistab graafikariistvara. Kaust, failivorming ja bitikiirused "
"seatakse lihtsas seadistusfailis."
