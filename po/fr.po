#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "À propos"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Version %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr ""
"Enregistreur d'écran et de son pour GNOME, piloté par des raccourcis clavier."

#: hotrec/about_window.py
msgid "Website"
msgstr "Site web"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Signaler un problème"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licence : %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Fermer"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Impossible de définir les raccourcis clavier"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Les raccourcis clavier sont définis"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Maj+F9 : écran et son. Ctrl+Maj+F10 : écran seul. Ctrl+Maj+F11 : son "
"seul. Ctrl+Maj+F12 : pause ou reprise. L'un des trois premiers arrête et "
"enregistre l'enregistrement."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Maj+F7 : zone et son. Ctrl+Maj+F8 : zone seule. Les deux arrêtent aussi "
"l'enregistrement et le sauvegardent."

#: hotrec/indicator.py
msgid "Paused"
msgstr "En pause"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Reprendre"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Enregistrement"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pause"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Arrêter et enregistrer"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Paramètres…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Le pilote vidéo VA-API est absent ou ne fonctionne pas. Avec un processeur "
"graphique Intel, installez intel-media-driver (RPM Fusion nonfree), puis "
"réessayez."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"L'encodeur vidéo n'a pas démarré. Le pilote graphique n'a peut-être pas "
"l'encodage vidéo matériel (VA-API ou NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s n'est pas un endroit sûr pour l'état de l'enregistrement"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "L'enregistrement s'est arrêté"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Impossible de démarrer l'enregistrement"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "La fenêtre de choix de la zone ne s'est pas ouverte"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Sortie son à enregistrer introuvable"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Impossible de créer le dossier %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s n'est pas installé"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s n'a pas démarré"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Impossible de démarrer l'enregistrement (journal : %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Enregistrement sauvegardé, mais la zone n'a pas pu être découpée : tout "
"l'écran est inclus"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Enregistrement sauvegardé"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Seule la vue est recadrée sur la zone : le reste de l'écran reste dans le "
"fichier"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "L'enregistrement est peut-être incomplet"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Faites glisser la zone à enregistrer. Échap ou le bouton droit annule."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Paramètres"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Réinitialiser aux valeurs par défaut"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Raccourcis clavier"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr ""
"Cliquez sur un champ, puis appuyez sur les nouvelles touches. Échap annule."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Vidéo"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Codec vidéo"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (lisible partout)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (taille de fichier réduite de moitié)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Débit vidéo"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Fréquence d'images"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Format du fichier vidéo"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 n'est pas disponible : la carte graphique ne peut pas l'encoder."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"Les vidéos H.265 peuvent nécessiter un codec supplémentaire pour être lues "
"sous Windows et dans certains navigateurs."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Son"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Codec audio pour les enregistrements sonores uniquement"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Débit audio avec vidéo"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Débit audio pour les enregistrements sonores uniquement"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"S'applique uniquement aux enregistrements sonores. Avec la vidéo, le son est "
"toujours AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Dossiers"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Les vidéos sont enregistrées dans"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Les enregistrements sonores sont enregistrés dans"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Choisir…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Choisir un dossier"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Appuyez sur les touches..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Utilisez Ctrl, Alt ou Super avec la touche."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Deux raccourcis ont les mêmes touches."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Réinitialiser tous les paramètres à leur valeur par défaut ?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Le point rouge clignotant au-dessus d'une vidéo en plein écran est activé. "
"Vous pouvez le désactiver dans l'application Extensions."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Le point rouge clignotant au-dessus d'une vidéo en plein écran est activé. "
"Si vous ne le voyez pas encore, fermez la session puis rouvrez-la une fois. "
"Vous pouvez le désactiver dans l'application Extensions."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Enregistrer une zone et le son"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Enregistrer une zone seule"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Enregistrer l'écran et le son"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Enregistrer l'écran seul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Enregistrer le son seul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Mettre en pause ou reprendre l'enregistrement"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Enregistrer l'écran et le son du bureau avec des raccourcis clavier"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Enregistreur d'écran et de son à raccourcis clavier"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Une touche enregistre l'écran et le son du bureau, une autre l'écran seul, "
"une autre le son seul en MP3. La même touche arrête et enregistre ; une "
"quatrième touche met en pause et reprend."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Les touches fonctionnent dans toutes les fenêtres, y compris sous Wayland. "
"Un point rouge dans la barre supérieure indique qu'un enregistrement est en "
"cours, un point jaune qu'il est en pause."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"L'écran est enregistré par le matériel graphique. Le dossier, le format de "
"fichier et les débits se règlent dans un simple fichier de configuration."
