#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Không thể đặt phím tắt"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Đã đặt phím tắt"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: màn hình và âm thanh. Ctrl+Shift+F10: chỉ màn hình. "
"Ctrl+Shift+F11: chỉ âm thanh. Ctrl+Shift+F12: tạm dừng hoặc tiếp tục. Bất kỳ "
"phím nào trong ba phím đầu đều dừng và lưu bản ghi."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Đã tạm dừng"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Tiếp tục"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Đang ghi"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Tạm dừng"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Dừng và lưu"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Đặt phím tắt..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Phím tắt"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Nhấp vào một ô rồi nhấn các phím mới. Esc để hủy."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Lưu video vào"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Lưu âm thanh vào"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Mặc định"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Lưu"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Chọn thư mục"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Không thể lưu các thư mục"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Nhấn các phím..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Dùng Ctrl, Alt hoặc Super cùng với phím."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Hai phím tắt có cùng tổ hợp phím."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Thiếu trình điều khiển video VA-API hoặc nó không hoạt động. Với đồ họa "
"Intel, hãy cài intel-media-driver (RPM Fusion nonfree) rồi thử lại."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Bộ mã hóa video không khởi động. Trình điều khiển đồ họa có thể thiếu tính "
"năng mã hóa video bằng phần cứng (VA-API hoặc NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s không phải nơi an toàn để lưu trạng thái ghi"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Quá trình ghi đã dừng"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Không thể bắt đầu ghi"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Cửa sổ chọn vùng không khởi động được"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Không tìm thấy đầu ra âm thanh cần ghi"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Không thể tạo thư mục %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s chưa được cài đặt"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s không khởi động"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Không thể bắt đầu ghi (nhật ký: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Đã lưu bản ghi, nhưng không cắt được vùng: toàn bộ màn hình nằm trong đó"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Đã lưu bản ghi"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Bản ghi có thể chưa đầy đủ"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "Kéo để chọn vùng cần ghi. Esc hoặc nút phải để hủy."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Chấm đỏ nhấp nháy phía trên video toàn màn hình đã được bật. Bạn có thể tắt "
"nó trong ứng dụng Tiện ích mở rộng."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Chấm đỏ nhấp nháy phía trên video toàn màn hình đã được bật. Nếu bạn chưa "
"thấy, hãy đăng xuất rồi đăng nhập lại một lần. Bạn có thể tắt nó trong ứng "
"dụng Tiện ích mở rộng."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Ghi vùng và âm thanh"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Chỉ ghi vùng"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Ghi màn hình và âm thanh"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Chỉ ghi màn hình"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Chỉ ghi âm thanh"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Tạm dừng hoặc tiếp tục ghi"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Ghi màn hình và âm thanh của màn hình nền bằng phím tắt"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Trình ghi màn hình và âm thanh bằng phím tắt"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Một phím ghi màn hình và âm thanh của màn hình nền, một phím khác chỉ ghi "
"màn hình, phím thứ ba chỉ ghi âm thanh dưới dạng MP3. Cùng phím đó dừng và "
"lưu bản ghi; phím thứ tư tạm dừng và tiếp tục nó."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Các phím hoạt động trong mọi cửa sổ, kể cả trên Wayland. Chấm đỏ trên thanh "
"trên cùng cho biết đang ghi, chấm vàng cho biết đang tạm dừng."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Màn hình được ghi bởi phần cứng đồ họa. Thư mục, định dạng tệp và tốc độ bit "
"được đặt trong một tệp cài đặt đơn giản."
