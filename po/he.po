#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "אודות"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "גרסה %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr "מקליט מסך ושמע עבור GNOME, מופעל על ידי קיצורי מקלדת."

#: hotrec/about_window.py
msgid "Website"
msgstr "אתר אינטרנט"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "דיווח על בעיה"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "רישיון: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "סגירה"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "לא ניתן היה להגדיר את קיצורי המקלדת"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "קיצורי המקלדת הוגדרו"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: מסך וצליל. Ctrl+Shift+F10: מסך בלבד. Ctrl+Shift+F11: צליל "
"בלבד. Ctrl+Shift+F12: השהיה או המשך. כל אחד משלושת הראשונים עוצר ושומר את "
"ההקלטה."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: אזור וצליל. Ctrl+Shift+F8: אזור בלבד. שניהם גם עוצרים ושומרים "
"את ההקלטה."

#: hotrec/indicator.py
msgid "Paused"
msgstr "מושהה"

#: hotrec/indicator.py
msgid "Resume"
msgstr "המשך"

#: hotrec/indicator.py
msgid "Recording"
msgstr "מקליט"

#: hotrec/indicator.py
msgid "Pause"
msgstr "השהיה"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "עצירה ושמירה"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "הגדרות…"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"מנהל ההתקן לווידאו VA-API חסר או שאינו פועל. עם כרטיס גרפי של Intel יש "
"להתקין את intel-media-driver (RPM Fusion nonfree) ולנסות שוב."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"מקודד הווידאו לא הופעל. ייתכן שבמנהל ההתקן הגרפי חסר קידוד וידאו בחומרה (VA-"
"API או NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s אינו מקום בטוח למצב ההקלטה"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "ההקלטה נעצרה"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "לא ניתן היה להתחיל בהקלטה"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "החלון לבחירת האזור לא הופעל"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "לא נמצא פלט השמע להקלטה"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "לא ניתן היה ליצור את התיקייה %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s אינו מותקן"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s לא הופעל"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "לא ניתן היה להתחיל בהקלטה (יומן: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr "ההקלטה נשמרה, אך לא ניתן היה לחתוך את האזור: כל המסך נמצא בה"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "ההקלטה נשמרה"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr "רק התצוגה נחתכת לאזור: שאר המסך נשאר בקובץ"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "ההקלטה עשויה להיות חלקית"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr "גררו כדי לבחור את האזור להקלטה. Esc או הלחצן הימני מבטלים."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "הגדרות"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "איפוס לברירות המחדל"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "קיצורי מקלדת"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "לחצו על שדה ואז הקישו את המקשים החדשים. Esc מבטל."

#: hotrec/settings_window.py
msgid "Video"
msgstr "וידאו"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "מקודד וידאו"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (מתנגן בכל מקום)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (בערך חצי מגודל הקובץ)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "קצב נתונים (וידאו)"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "קצב פריימים"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "פורמט קובץ וידאו"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 אינו זמין: כרטיס המסך אינו יכול לקודד אותו."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"סרטוני H.265 עשויים לדרוש מקודד נוסף כדי להתנגן ב-Windows ובחלק מהדפדפנים."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "שמע"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "מקודד שמע להקלטות שמע בלבד"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "קצב נתוני שמע עם וידאו"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "קצב נתוני שמע להקלטות שמע בלבד"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr "חל רק על הקלטות שמע בלבד. בוידאו, השמע הוא תמיד AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "תיקיות"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "סרטונים נשמרים ב-"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "הקלטות שמע נשמרות ב-"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "בחירה…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "בחירת תיקייה"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "הקישו את המקשים..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "השתמשו ב-Ctrl, ב-Alt או ב-Super יחד עם המקש."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "לשני קיצורים יש אותם מקשים."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "לאפס כל הגדרה לערך ברירת המחדל שלה?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"הנקודה האדומה המהבהבת מעל סרטון במסך מלא מופעלת. אפשר לכבות אותה ביישום "
"ההרחבות."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"הנקודה האדומה המהבהבת מעל סרטון במסך מלא מופעלת. אם אינך רואה אותה עדיין, צא "
"והיכנס פעם אחת. אפשר לכבות אותה ביישום ההרחבות."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "הקלטת אזור וצליל"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "הקלטת האזור בלבד"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "הקלטת מסך וצליל"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "הקלטת המסך בלבד"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "הקלטת הצליל בלבד"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "השהיית ההקלטה או המשכה"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "מקליט את המסך ואת הצליל של שולחן העבודה בעזרת קיצורי מקלדת"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "מקליט מסך וצליל עם קיצורי מקלדת"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"מקש אחד מקליט את המסך ואת הצליל של שולחן העבודה, אחר רק את המסך, ושלישי רק "
"את הצליל כ-MP3. אותו מקש עוצר ושומר את ההקלטה, ורביעי משהה אותה וממשיך אותה."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"המקשים פועלים בכל חלון, גם ב-Wayland. נקודה אדומה בסרגל העליון מראה שהקלטה "
"מתבצעת, וצהובה שהיא מושהית."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"המסך מוקלט בידי חומרת הגרפיקה. התיקייה, פורמט הקובץ וקצבי הסיביות נקבעים "
"בקובץ הגדרות פשוט."
