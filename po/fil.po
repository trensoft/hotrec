#: hotrec/cli.py
msgid "Could not set the keyboard shortcuts"
msgstr "Hindi maitakda ang mga keyboard shortcut"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Naitakda na ang mga keyboard shortcut"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: screen at tunog. Ctrl+Shift+F10: screen lang. Ctrl+Shift+F11: "
"tunog lang. Ctrl+Shift+F12: i-pause o ipagpatuloy. Ang alinman sa unang "
"tatlo ay humihinto at nagse-save ng recording."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Naka-pause"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Ipagpatuloy"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Nagre-record"

#: hotrec/indicator.py
msgid "Pause"
msgstr "I-pause"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Ihinto at i-save"

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "Ang %s ay hindi ligtas na lugar para sa estado ng recording"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Hindi nahanap ang audio output na ire-record"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Hindi masimulan ang recording"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Hindi magawa ang folder na %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "Hindi naka-install ang %s"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "Hindi nagsimula ang %s"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Hindi masimulan ang recording (log: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Na-save ang recording"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Maaaring hindi kumpleto ang recording"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "I-record ang screen at tunog"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "I-record ang screen lang"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "I-record ang tunog lang"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "I-pause o ipagpatuloy ang recording"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr ""
"Nire-record ang screen at tunog ng desktop gamit ang mga keyboard shortcut"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Recorder ng screen at tunog na may mga keyboard shortcut"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Ang isang key ay nagre-record ng screen at tunog ng desktop, ang isa ay "
"screen lang, ang isa pa ay tunog lang bilang MP3. Ang parehong key ay "
"humihinto at nagse-save ng recording; ang ikaapat ay nagpa-pause at "
"nagpapatuloy nito."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Gumagana ang mga key sa bawat window, pati sa Wayland. Ang pulang tuldok sa "
"itaas na bar ay nagpapakitang may nagre-record, ang dilaw na naka-pause ito."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Ang screen ay nire-record ng graphics hardware. Ang folder, format ng file, "
"at bitrate ay itinatakda sa isang simpleng settings file."
