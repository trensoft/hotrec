#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Neizdevās iestatīt tastatūras īsinājumtaustiņus"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Tastatūras īsinājumtaustiņi ir iestatīti"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: ekrāns un skaņa. Ctrl+Shift+F10: tikai ekrāns. "
"Ctrl+Shift+F11: tikai skaņa. Ctrl+Shift+F12: pauzēt vai turpināt. Jebkurš no "
"pirmajiem trim aptur un saglabā ierakstu."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Pauzēts"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Turpināt"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Ieraksta"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pauzēt"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Apturēt un saglabāt"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Iestatīt tastatūras īsinājumtaustiņus..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Tastatūras īsinājumtaustiņi"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Noklikšķiniet uz lauka un nospiediet jaunos taustiņus. Esc atceļ."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Saglabāt video mapē"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Saglabāt skaņu mapē"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Noklusējums"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Saglabāt"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Izvēlēties mapi"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Neizdevās saglabāt mapes"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Nospiediet taustiņus..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Izmantojiet Ctrl, Alt vai Super kopā ar taustiņu."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Diviem īsinājumtaustiņiem ir vieni un tie paši taustiņi."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API video draivera nav vai tas nedarbojas. Ar Intel grafiku instalējiet "
"intel-media-driver (RPM Fusion nonfree) un mēģiniet vēlreiz."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Video kodētājs nestartējās. Grafikas draiverim var trūkt aparatūras video "
"kodēšanas (VA-API vai NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s nav droša vieta ieraksta stāvoklim"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Ierakstīšana apstājās"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Neatrada ierakstāmo skaņas izeju"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Neizdevās sākt ierakstu"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Neizdevās izveidot mapi %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s nav uzstādīts"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s neuzsākās"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Neizdevās sākt ierakstu (žurnāls: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Ieraksts saglabāts"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Ieraksts var būt nepilnīgs"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Mirgojošs sarkans punkts virs pilnekrāna video ir ieslēgts. Ja to vēl "
"neredzat, vienreiz izrakstieties un pierakstieties vēlreiz. To var izslēgt "
"lietotnē „Paplašinājumi“."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Ierakstīt ekrānu un skaņu"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Ierakstīt tikai ekrānu"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Ierakstīt tikai skaņu"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pauzēt vai turpināt ierakstu"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Ieraksta darbvirsmas ekrānu un skaņu ar tastatūras īsinājumtaustiņiem"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Ekrāna un skaņas ierakstītājs ar tastatūras īsinājumtaustiņiem"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Viens taustiņš ieraksta darbvirsmas ekrānu un skaņu, otrs tikai ekrānu, "
"trešais tikai skaņu kā MP3. Tas pats taustiņš aptur un saglabā ierakstu; "
"ceturtais to pauzē un turpina."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Taustiņi darbojas katrā logā, arī Wayland vidē. Sarkans punkts augšējā joslā "
"rāda, ka notiek ieraksts, dzeltens, ka tas ir pauzēts."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Ekrānu ieraksta grafikas aparatūra. Mape, faila formāts un bitu pārraides "
"ātrumi tiek iestatīti vienkāršā iestatījumu failā."
