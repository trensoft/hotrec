#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Nepavyko nustatyti spartaus klavišų"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Spartieji klavišai nustatyti"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: ekranas ir garsas. Ctrl+Shift+F10: tik ekranas. "
"Ctrl+Shift+F11: tik garsas. Ctrl+Shift+F12: pristabdyti arba tęsti. Bet "
"kuris iš pirmųjų trijų sustabdo ir išsaugo įrašą."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: sritis ir garsas. Ctrl+Shift+F8: tik sritis. Abu taip pat "
"sustabdo ir išsaugo įrašą."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Pristabdyta"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Tęsti"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Įrašoma"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pristabdyti"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Sustabdyti ir išsaugoti"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Nustatyti sparčiuosius klavišus..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Spartieji klavišai"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Spustelėkite lauką, tada paspauskite naujus klavišus. Esc atšaukia."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Įrašyti vaizdo įrašus į"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Įrašyti garsą į"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Numatytasis"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Įrašyti"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Pasirinkti aplanką"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Nepavyko įrašyti aplankų"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Paspauskite klavišus..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Naudokite Ctrl, Alt arba Super kartu su klavišu."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Du spartieji klavišai turi tuos pačius klavišus."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API vaizdo tvarkyklės trūksta arba ji neveikia. Naudojant „Intel“ "
"grafiką, įdiekite intel-media-driver (RPM Fusion nonfree) ir bandykite dar "
"kartą."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Vaizdo kodavimo priemonė nepasileido. Grafikos tvarkyklei gali trūkti "
"aparatinio vaizdo kodavimo (VA-API arba NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s nėra saugi vieta įrašymo būsenai"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Įrašymas sustojo"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Nepavyko pradėti įrašymo"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Srities pasirinkimo langas nepasileido"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Nerasta įrašytina garso išvestis"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Nepavyko sukurti aplanko %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s neįdiegta"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s nepasileido"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Nepavyko pradėti įrašymo (žurnalas: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Įrašas išsaugotas, bet srities iškirpti nepavyko: jame yra visas ekranas"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Įrašas išsaugotas"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr "Tik vaizdas apkarpomas iki srities: likusi ekrano dalis lieka faile"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Įrašas gali būti neišsamus"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Vilkite, kad pasirinktumėte įrašomą sritį. Esc arba dešinysis mygtukas "
"atšaukia."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Mirksintis raudonas taškas virš viso ekrano vaizdo įrašo įjungtas. Išjungti "
"jį galite programoje „Plėtiniai“."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Mirksintis raudonas taškas virš viso ekrano vaizdo įrašo įjungtas. Jei jo "
"dar nematote, vieną kartą atsijunkite ir vėl prisijunkite. Išjungti jį "
"galite programoje „Plėtiniai“."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Įrašyti sritį ir garsą"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Įrašyti tik sritį"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Įrašyti ekraną ir garsą"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Įrašyti tik ekraną"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Įrašyti tik garsą"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pristabdyti arba tęsti įrašymą"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Įrašo darbalaukio ekraną ir garsą spartiaisiais klavišais"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Ekrano ir garso įrašymo programa su sparčiaisiais klavišais"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Vienas klavišas įrašo darbalaukio ekraną ir garsą, kitas tik ekraną, trečias "
"tik garsą kaip MP3. Tas pats klavišas sustabdo ir išsaugo įrašą; ketvirtas "
"jį pristabdo ir tęsia."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Klavišai veikia kiekviename lange, taip pat ir Wayland aplinkoje. Raudonas "
"taškas viršutinėje juostoje rodo, kad įrašoma, geltonas, kad pristabdyta."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Ekraną įrašo grafikos aparatinė įranga. Aplankas, failo formatas ir bitų "
"sparta nustatomi paprastame nustatymų faile."
