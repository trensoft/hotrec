#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "Dwar"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Verżjoni %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr ""
"Rekorder tal-iskrin u tal-ħoss għal GNOME, immexxi minn shortcuts tat-"
"tastiera."

#: hotrec/about_window.py
msgid "Website"
msgstr "Sit web"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Irrapporta problema"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Liċenzja: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Agħlaq"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Ma stajtx jiġu ssettjati x-shortcuts tat-tastiera"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Ix-shortcuts tat-tastiera huma ssettjati"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: skrin u ħoss. Ctrl+Shift+F10: skrin biss. Ctrl+Shift+F11: "
"ħoss biss. Ctrl+Shift+F12: waqqaf jew kompli. Kwalunkwe waħda mill-ewwel "
"tlieta twaqqaf u żżomm ir-reġistrazzjoni."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: żona u ħoss. Ctrl+Shift+F8: żona biss. It-tnejn iwaqqfu u "
"jsejvjaw ir-reġistrazzjoni wkoll."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Waqfa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Kompli"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Qed jirreġistra"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Waqqaf"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Waqqaf u ssejvja"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Settings…"

#: hotrec/indicator.py
msgid "Quit"
msgstr "Oħroġ"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Is-sewwieq tal-vidjo VA-API nieqes jew ma jaħdimx. Bi grafika Intel, "
"installa intel-media-driver (RPM Fusion nonfree) u erġa' pprova."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"L-enkoder tal-vidjo ma nbediex. Jista' jkun li s-sewwieq tal-grafika jonqsu "
"l-kodifikazzjoni tal-vidjo bil-ħardwer (VA-API jew NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s mhuwiex post sigur għall-istat tar-reġistrazzjoni"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "It-tiġrija twaqqfet"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Ir-reġistrazzjoni ma setgħetx tibda"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "It-tieqa biex tintgħażel iż-żona ma nfetħitx"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "L-output tal-ħoss li għandu jiġi rreġistrat ma nstabx"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Il-folder %s ma setax jinħoloq"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s mhuwiex installat"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s ma bediex"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Ir-reġistrazzjoni ma setgħetx tibda (log: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Ir-reġistrazzjoni ssejvjat, imma ż-żona ma setgħetx titqatta': hemm l-iskrin "
"kollu"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Ir-reġistrazzjoni ssejvjat"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Il-veduta biss titqatta' għaż-żona: il-bqija tal-iskrin jibqa' fil-fajl"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Ir-reġistrazzjoni tista' tkun mhux kompluta"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Kebbes biex tagħżel iż-żona li se tirreġistra. Esc jew il-buttuna tal-lemin "
"jikkanċellaw."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Settings"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Irrisettja għad-defaults"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Shortcuts tat-tastiera"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr ""
"Ikklikkja fuq qasam, imbagħad agħfas it-tasti l-ġodda. Esc jikkanċella."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Vidjo"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Codec tal-vidjo"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (jaħdem kullimkien)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (madwar nofs id-daqs tal-fajl)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Bitrate tal-vidjo"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Frame rate"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Format tal-fajl tal-vidjo"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 mhuwiex disponibbli: il-karta grafika ma tistax tikkodifikah."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"Vidjos H.265 jista' jkollhom bżonn codec żejjed biex jaħdmu fuq Windows u "
"f'xi browsers."

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr ""
"Ir-reġistrazzjonijiet ta' żona dejjem huma H.264, anki jekk "
"jintgħażel H.265."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Ħoss"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Codec tal-ħoss għal reġistrazzjonijiet tal-ħoss biss"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Bitrate tal-ħoss bil-vidjo"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Bitrate tal-ħoss għal reġistrazzjonijiet tal-ħoss biss"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"Japplika biss għal reġistrazzjonijiet tal-ħoss biss. Bil-vidjo, il-ħoss "
"dejjem ikun AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Folders"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Il-vidjos jiġu ssejvjati f'"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Ir-reġistrazzjonijiet tal-ħoss jiġu ssejvjati f'"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Agħżel…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Agħżel cartella"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Agħfas it-tasti..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Uża Ctrl, Alt jew Super flimkien mat-tasta."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Tnejn mix-shortcuts għandhom l-istess tasti."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Irrisettja kull setting għall-valur default tiegħu?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Il-punt aħmar li jteptep fuq vidjo fuq l-iskrin kollu huwa mixgħul. Tista' "
"titfih fl-app Estensjonijiet."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Il-punt aħmar li jteptep fuq vidjo fuq l-iskrin kollu huwa mixgħul. Jekk "
"għadek ma tarahx, oħroġ u idħol għal darba. Tista' titfih fl-app "
"Estensjonijiet."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Irreġistra żona u ħoss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Irreġistra żona biss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Irreġistra skrin u ħoss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Irreġistra skrin biss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Irreġistra ħoss biss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Waqqaf jew kompli r-reġistrazzjoni"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Jirreġistra l-iskrin u l-ħoss tad-desktop bi shortcuts tat-tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Reġistratur tal-iskrin u tal-ħoss bi shortcuts tat-tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Ċavetta waħda tirreġistra l-iskrin u l-ħoss tad-desktop, oħra l-iskrin biss, "
"oħra l-ħoss biss bħala MP3. L-istess ċavetta twaqqaf u żżomm ir-"
"reġistrazzjoni; raba' ċavetta twaqqafha u tkompliha."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Iċ-ċwievet jaħdmu f'kull tieqa, anke fuq Wayland. Punt aħmar fil-bar ta' fuq "
"juri li r-reġistrazzjoni għaddejja, wieħed isfar li hija waqfa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"L-iskrin jiġi rreġistrat mill-hardware grafiku. Il-folder, il-format tal-"
"fajl u r-rati tal-bits jiġu ssettjati f'fajl tas-settings sempliċi."
