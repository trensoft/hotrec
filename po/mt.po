#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Ma stajtx jiġu ssettjati x-shortcuts tat-tastiera"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Ix-shortcuts tat-tastiera huma ssettjati"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: skrin u ħoss. Ctrl+Shift+F10: skrin biss. Ctrl+Shift+F11: "
"ħoss biss. Ctrl+Shift+F12: waqqaf jew kompli. Kwalunkwe waħda mill-ewwel "
"tlieta twaqqaf u żżomm ir-reġistrazzjoni."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Waqfa"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Kompli"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Qed jirreġistra"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Waqqaf"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Waqqaf u ssejvja"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Issettja x-shortcuts tat-tastiera..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Shortcuts tat-tastiera"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr ""
"Ikklikkja fuq qasam, imbagħad agħfas it-tasti l-ġodda. Esc jikkanċella."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Issejvja l-vidjows f'"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Issejvja l-awdjo f'"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Awtomatiku"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Ssejvja"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Agħżel cartella"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Ma setgħux jiġu ssejvjati l-folders"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Agħfas it-tasti..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Uża Ctrl, Alt jew Super flimkien mat-tasta."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Tnejn mix-shortcuts għandhom l-istess tasti."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Is-sewwieq tal-vidjo VA-API nieqes jew ma jaħdimx. Bi grafika Intel, "
"installa intel-media-driver (RPM Fusion nonfree) u erġa' pprova."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"L-enkoder tal-vidjo ma nbediex. Jista' jkun li s-sewwieq tal-grafika jonqsu "
"l-kodifikazzjoni tal-vidjo bil-ħardwer (VA-API jew NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s mhuwiex post sigur għall-istat tar-reġistrazzjoni"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "It-tiġrija twaqqfet"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "L-output tal-ħoss li għandu jiġi rreġistrat ma nstabx"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Ir-reġistrazzjoni ma setgħetx tibda"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Il-folder %s ma setax jinħoloq"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s mhuwiex installat"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s ma bediex"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Ir-reġistrazzjoni ma setgħetx tibda (log: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Ir-reġistrazzjoni ssejvjat"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Ir-reġistrazzjoni tista' tkun mhux kompluta"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Irreġistra skrin u ħoss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Irreġistra skrin biss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Irreġistra ħoss biss"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Waqqaf jew kompli r-reġistrazzjoni"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Jirreġistra l-iskrin u l-ħoss tad-desktop bi shortcuts tat-tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Reġistratur tal-iskrin u tal-ħoss bi shortcuts tat-tastiera"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Ċavetta waħda tirreġistra l-iskrin u l-ħoss tad-desktop, oħra l-iskrin biss, "
"oħra l-ħoss biss bħala MP3. L-istess ċavetta twaqqaf u żżomm ir-"
"reġistrazzjoni; raba' ċavetta twaqqafha u tkompliha."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Iċ-ċwievet jaħdmu f'kull tieqa, anke fuq Wayland. Punt aħmar fil-bar ta' fuq "
"juri li r-reġistrazzjoni għaddejja, wieħed isfar li hija waqfa."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"L-iskrin jiġi rreġistrat mill-hardware grafiku. Il-folder, il-format tal-"
"fajl u r-rati tal-bits jiġu ssettjati f'fajl tas-settings sempliċi."
