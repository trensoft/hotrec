#: hotrec/about_window.py hotrec/indicator.py
msgid "About"
msgstr "Despre"

#: hotrec/about_window.py
#, python-format
msgid "Version %s"
msgstr "Versiunea %s"

#: hotrec/about_window.py
msgid "Screen and sound recorder for GNOME, driven by keyboard shortcuts."
msgstr ""
"Înregistrator de ecran și sunet pentru GNOME, condus de scurtături de "
"tastatură."

#: hotrec/about_window.py
msgid "Website"
msgstr "Pagină web"

#: hotrec/about_window.py
msgid "Report a problem"
msgstr "Raportează o problemă"

#: hotrec/about_window.py
#, python-format
msgid "License: %s"
msgstr "Licență: %s"

#: hotrec/about_window.py hotrec/settings_window.py
msgid "Close"
msgstr "Închide"

#: hotrec/cli.py hotrec/settings_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Nu s-au putut seta scurtăturile de tastatură"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Scurtăturile de tastatură sunt setate"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: ecran și sunet. Ctrl+Shift+F10: doar ecran. Ctrl+Shift+F11: "
"doar sunet. Ctrl+Shift+F12: pauză sau reluare. Oricare dintre primele trei "
"oprește și salvează înregistrarea."

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F7: area and sound. Ctrl+Shift+F8: area only. Both also stop and "
"save the recording."
msgstr ""
"Ctrl+Shift+F7: zonă și sunet. Ctrl+Shift+F8: doar zonă. Ambele opresc și "
"salvează totodată înregistrarea."

#: hotrec/indicator.py
msgid "Paused"
msgstr "În pauză"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Reia"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Se înregistrează"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pauză"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Oprește și salvează"

#: hotrec/indicator.py
msgid "Settings…"
msgstr "Configurări…"

#: hotrec/indicator.py
msgid "Quit"
msgstr "Ieșire"

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Driverul video VA-API lipsește sau nu funcționează. Cu grafică Intel, "
"instalați intel-media-driver (RPM Fusion nonfree) și încercați din nou."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Codificatorul video nu a pornit. Este posibil ca driverul grafic să nu aibă "
"codare video hardware (VA-API sau NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s nu este un loc sigur pentru starea înregistrării"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Înregistrarea s-a oprit"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Înregistrarea nu a putut porni"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Fereastra pentru alegerea zonei nu a pornit"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Ieșirea de sunet de înregistrat nu a fost găsită"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Dosarul %s nu a putut fi creat"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s nu este instalat"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s nu a pornit"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Înregistrarea nu a putut porni (jurnal: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Înregistrare salvată, dar zona nu a putut fi decupată: ecranul întreg este "
"inclus"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Înregistrare salvată"

#: hotrec/recorder.py
msgid ""
"Only the view is cropped to the area: the rest of the screen stays in the "
"file"
msgstr ""
"Doar vizualizarea este decupată la zonă: restul ecranului rămâne în fișier"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Înregistrarea ar putea fi incompletă"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Trageți pentru a alege zona de înregistrat. Esc sau butonul drept anulează."

#: hotrec/settings_window.py
#, python-format
msgid "%d kbit/s"
msgstr "%d kbit/s"

#: hotrec/settings_window.py
#, python-format
msgid "%.1f Mbit/s"
msgstr "%.1f Mbit/s"

#: hotrec/settings_window.py
msgid "Settings"
msgstr "Configurări"

#: hotrec/settings_window.py
msgid "Reset to defaults"
msgstr "Restabilește la implicite"

#: hotrec/settings_window.py
msgid "Keyboard shortcuts"
msgstr "Scurtături de tastatură"

#: hotrec/settings_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Faceți clic pe un câmp, apoi apăsați tastele noi. Esc anulează."

#: hotrec/settings_window.py
msgid "Video"
msgstr "Video"

#: hotrec/settings_window.py
msgid "Video codec"
msgstr "Codec video"

#: hotrec/settings_window.py
msgid "H.264 (plays everywhere)"
msgstr "H.264 (redare oriunde)"

#: hotrec/settings_window.py
msgid "H.265 (about half the file size)"
msgstr "H.265 (aproximativ jumătate din dimensiunea fișierului)"

#: hotrec/settings_window.py
msgid "Video bitrate"
msgstr "Rată de biți video"

#: hotrec/settings_window.py
msgid "Frame rate"
msgstr "Rată de cadre"

#: hotrec/settings_window.py
msgid "Video file format"
msgstr "Format fișier video"

#: hotrec/settings_window.py
msgid "H.265 is not available: the graphics card cannot encode it."
msgstr "H.265 nu este disponibil: placa video nu îl poate coda."

#: hotrec/settings_window.py
msgid ""
"H.265 videos may need an extra codec to play on Windows and in some browsers."
msgstr ""
"Videoclipurile H.265 pot avea nevoie de un codec suplimentar pentru a fi "
"redate pe Windows și în unele browsere."

#: hotrec/settings_window.py
msgid "Area recordings are always H.264, even when H.265 is chosen."
msgstr ""
"Înregistrările unei zone sunt întotdeauna H.264, chiar dacă este ales "
"H.265."

#: hotrec/settings_window.py
msgid "Sound"
msgstr "Sunet"

#: hotrec/settings_window.py
msgid "Sound codec for sound-only recordings"
msgstr "Codec de sunet pentru înregistrări doar cu sunet"

#: hotrec/settings_window.py
msgid "Sound bitrate with video"
msgstr "Rată de biți sunet cu video"

#: hotrec/settings_window.py
msgid "Sound bitrate for sound-only recordings"
msgstr "Rată de biți sunet pentru înregistrări doar cu sunet"

#: hotrec/settings_window.py
msgid ""
"Applies only to sound-only recordings. With video, the sound is always AAC."
msgstr ""
"Se aplică doar la înregistrările doar cu sunet. Cu video, sunetul este mereu "
"AAC."

#: hotrec/settings_window.py
msgid "Folders"
msgstr "Dosare"

#: hotrec/settings_window.py
msgid "Videos are saved in"
msgstr "Videoclipurile sunt salvate în"

#: hotrec/settings_window.py
msgid "Sound recordings are saved in"
msgstr "Înregistrările audio sunt salvate în"

#: hotrec/settings_window.py
msgid "Choose…"
msgstr "Alegeți…"

#: hotrec/settings_window.py
#, python-format
msgid "%d fps"
msgstr "%d fps"

#: hotrec/settings_window.py
msgid "Choose a folder"
msgstr "Alegeți un dosar"

#: hotrec/settings_window.py
msgid "Press the keys..."
msgstr "Apăsați tastele..."

#: hotrec/settings_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Folosiți Ctrl, Alt sau Super împreună cu tasta."

#: hotrec/settings_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Două scurtături au aceleași taste."

#: hotrec/settings_window.py
msgid "Reset every setting to its default value?"
msgstr "Restabiliți fiecare setare la valoarea sa implicită?"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Punctul roșu intermitent peste un videoclip pe tot ecranul este activat. Îl "
"puteți dezactiva în aplicația Extensii."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Punctul roșu intermitent peste un videoclip pe tot ecranul este activat. "
"Dacă nu îl vedeți încă, deconectați-vă și conectați-vă din nou o dată. Îl "
"puteți dezactiva în aplicația Extensii."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Înregistrează zona și sunetul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Înregistrează doar zona"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Înregistrează ecranul și sunetul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Înregistrează doar ecranul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Înregistrează doar sunetul"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Pune în pauză sau reia înregistrarea"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr ""
"Înregistrează ecranul și sunetul desktopului cu scurtături de tastatură"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Înregistrator de ecran și sunet cu scurtături de tastatură"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"O tastă înregistrează ecranul și sunetul desktopului, alta doar ecranul, "
"alta doar sunetul ca MP3. Aceeași tastă oprește și salvează înregistrarea; a "
"patra o pune în pauză și o reia."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tastele funcționează în orice fereastră, și sub Wayland. Un punct roșu în "
"bara de sus arată că o înregistrare rulează, unul galben că este în pauză."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Ecranul este înregistrat de hardware-ul grafic. Dosarul, formatul fișierului "
"și ratele de biți se stabilesc într-un fișier simplu de setări."
