#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "تعذّر ضبط اختصارات لوحة المفاتيح"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "تم ضبط اختصارات لوحة المفاتيح"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: الشاشة والصوت. Ctrl+Shift+F10: الشاشة فقط. Ctrl+Shift+F11: "
"الصوت فقط. Ctrl+Shift+F12: إيقاف مؤقت أو استئناف. أيٌّ من الثلاثة الأولى يوقف "
"التسجيل ويحفظه."

#: hotrec/indicator.py
msgid "Paused"
msgstr "متوقف مؤقتًا"

#: hotrec/indicator.py
msgid "Resume"
msgstr "استئناف"

#: hotrec/indicator.py
msgid "Recording"
msgstr "جارٍ التسجيل"

#: hotrec/indicator.py
msgid "Pause"
msgstr "إيقاف مؤقت"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "إيقاف وحفظ"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "ضبط اختصارات لوحة المفاتيح..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "اختصارات لوحة المفاتيح"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "انقر على حقل ثم اضغط المفاتيح الجديدة. يلغي Esc العملية."

#: hotrec/keys_window.py
msgid "Save"
msgstr "حفظ"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "اضغط المفاتيح..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "استخدم Ctrl أو Alt أو Super مع المفتاح."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "لدى اختصارين المفاتيح نفسها."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s ليس مكانًا آمنًا لحالة التسجيل"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "تعذّر العثور على مخرج الصوت المراد تسجيله"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "تعذّر بدء التسجيل"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "تعذّر إنشاء المجلد %s"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s غير مثبّت"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "لم يبدأ %s"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "تعذّر بدء التسجيل (السجل: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "تم حفظ التسجيل"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "قد يكون التسجيل غير مكتمل"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "تسجيل الشاشة والصوت"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "تسجيل الشاشة فقط"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "تسجيل الصوت فقط"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "إيقاف التسجيل مؤقتًا أو استئنافه"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "يسجّل شاشة سطح المكتب وصوته باختصارات لوحة المفاتيح"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "مسجّل للشاشة والصوت باختصارات لوحة المفاتيح"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"مفتاح واحد يسجّل شاشة سطح المكتب وصوته، وآخر يسجّل الشاشة فقط، وثالث يسجّل "
"الصوت فقط بصيغة MP3. المفتاح نفسه يوقف التسجيل ويحفظه، ورابع يوقفه مؤقتًا "
"ويستأنفه."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"تعمل المفاتيح في كل نافذة، وكذلك في Wayland. تدل النقطة الحمراء في الشريط "
"العلوي على أن التسجيل جارٍ، والصفراء على أنه متوقف مؤقتًا."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"تسجّل عتاديات الرسوميات الشاشة. يُحدَّد المجلد وصيغة الملف ومعدلات البتات في ملف "
"إعدادات بسيط."
