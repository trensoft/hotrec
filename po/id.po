#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Pintasan papan ketik tidak dapat diatur"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Pintasan papan ketik sudah diatur"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Shift+F9: layar dan suara. Ctrl+Shift+F10: layar saja. Ctrl+Shift+F11: "
"suara saja. Ctrl+Shift+F12: jeda atau lanjutkan. Salah satu dari tiga yang "
"pertama menghentikan dan menyimpan rekaman."

#: hotrec/indicator.py
msgid "Paused"
msgstr "Dijeda"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Lanjutkan"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Merekam"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Jeda"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Hentikan dan simpan"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Atur pintasan papan ketik..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Pintasan papan ketik"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klik sebuah kolom, lalu tekan tombol baru. Esc membatalkan."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Simpan video di"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Simpan audio di"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Bawaan"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Simpan"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Pilih folder"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Folder tidak dapat disimpan"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Tekan tombolnya..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Gunakan Ctrl, Alt, atau Super bersama tombol."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "Dua pintasan memiliki tombol yang sama."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"Driver video VA-API tidak ada atau tidak berfungsi. Pada grafis Intel, "
"pasang intel-media-driver (RPM Fusion nonfree), lalu coba lagi."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Encoder video tidak dimulai. Driver grafis mungkin tidak memiliki pengodean "
"video perangkat keras (VA-API atau NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s bukan tempat yang aman untuk status rekaman"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Perekaman berhenti"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Rekaman tidak dapat dimulai"

#: hotrec/recorder.py
msgid "The window to choose the area did not start"
msgstr "Jendela untuk memilih area tidak dapat dimulai"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Keluaran suara yang akan direkam tidak ditemukan"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Folder %s tidak dapat dibuat"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s belum terpasang"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s tidak berjalan"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Rekaman tidak dapat dimulai (log: %s)"

#: hotrec/recorder.py
msgid ""
"Recording saved, but the area could not be cut out: the whole screen is in it"
msgstr ""
"Rekaman disimpan, tetapi area tidak dapat dipotong: seluruh layar ada di "
"dalamnya"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Rekaman disimpan"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Rekaman mungkin tidak lengkap"

#: hotrec/selector.py
msgid "Drag the area to record. Esc or the right button cancels."
msgstr ""
"Seret untuk memilih area yang direkam. Esc atau tombol kanan membatalkan."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Titik merah berkedip di atas video layar penuh sudah aktif. Anda dapat "
"mematikannya di aplikasi Ekstensi."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Titik merah berkedip di atas video layar penuh sudah aktif. Jika belum "
"terlihat, keluar lalu masuk lagi satu kali. Anda dapat mematikannya di "
"aplikasi Ekstensi."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area and sound"
msgstr "Rekam area dan suara"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record area only"
msgstr "Rekam area saja"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Rekam layar dan suara"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Rekam layar saja"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Rekam suara saja"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Jeda atau lanjutkan rekaman"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Merekam layar dan suara desktop dengan pintasan papan ketik"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Perekam layar dan suara dengan pintasan papan ketik"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Satu tombol merekam layar dan suara desktop, tombol lain hanya layar, tombol "
"ketiga hanya suara sebagai MP3. Tombol yang sama menghentikan dan menyimpan "
"rekaman; tombol keempat menjeda dan melanjutkannya."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tombol bekerja di setiap jendela, juga di Wayland. Titik merah di bilah atas "
"menunjukkan rekaman sedang berjalan, titik kuning menunjukkan rekaman dijeda."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Layar direkam oleh perangkat keras grafis. Folder, format berkas, dan "
"bitrate diatur dalam berkas pengaturan sederhana."
