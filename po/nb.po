#: hotrec/cli.py hotrec/keys_window.py
msgid "Could not set the keyboard shortcuts"
msgstr "Tastatursnarveiene kunne ikke settes"

#: hotrec/cli.py
msgid "Keyboard shortcuts are set"
msgstr "Tastatursnarveiene er satt"

#: hotrec/cli.py
msgid ""
"Ctrl+Shift+F9: screen and sound. Ctrl+Shift+F10: screen only. "
"Ctrl+Shift+F11: sound only. Ctrl+Shift+F12: pause or resume. Any of the "
"first three stops and saves the recording."
msgstr ""
"Ctrl+Skift+F9: skjerm og lyd. Ctrl+Skift+F10: bare skjerm. Ctrl+Skift+F11: "
"bare lyd. Ctrl+Skift+F12: pause eller fortsett. En av de tre første stopper "
"og lagrer opptaket."

#: hotrec/indicator.py
msgid "Paused"
msgstr "På pause"

#: hotrec/indicator.py
msgid "Resume"
msgstr "Fortsett"

#: hotrec/indicator.py
msgid "Recording"
msgstr "Tar opp"

#: hotrec/indicator.py
msgid "Pause"
msgstr "Pause"

#: hotrec/indicator.py
msgid "Stop and save"
msgstr "Stopp og lagre"

#: hotrec/indicator.py
msgid "Set keyboard shortcuts..."
msgstr "Angi tastatursnarveier..."

#: hotrec/keys_window.py
msgid "Keyboard shortcuts"
msgstr "Tastatursnarveier"

#: hotrec/keys_window.py
msgid "Click a field, then press the new keys. Escape cancels."
msgstr "Klikk på et felt og trykk på de nye tastene. Esc avbryter."

#: hotrec/keys_window.py
msgid "Save videos in"
msgstr "Lagre videoer i"

#: hotrec/keys_window.py
msgid "Save audio in"
msgstr "Lagre lyd i"

#: hotrec/keys_window.py
msgid "Default"
msgstr "Standard"

#: hotrec/keys_window.py
msgid "Save"
msgstr "Lagre"

#: hotrec/keys_window.py
msgid "Choose a folder"
msgstr "Velg en mappe"

#: hotrec/keys_window.py
msgid "Could not save the folders"
msgstr "Kunne ikke lagre mappene"

#: hotrec/keys_window.py
msgid "Press the keys..."
msgstr "Trykk på tastene..."

#: hotrec/keys_window.py
msgid "Use Ctrl, Alt or Super together with the key."
msgstr "Bruk Ctrl, Alt eller Super sammen med tasten."

#: hotrec/keys_window.py
msgid "Two of the shortcuts have the same keys."
msgstr "To snarveier har de samme tastene."

#: hotrec/recorder.py
msgid ""
"The VA-API video driver is missing or does not work. On Intel graphics, "
"install intel-media-driver (RPM Fusion nonfree), then try again."
msgstr ""
"VA-API-videodriveren mangler eller fungerer ikke. Med Intel-grafikk må du "
"installere intel-media-driver (RPM Fusion nonfree) og prøve igjen."

#: hotrec/recorder.py
msgid ""
"The video encoder did not start. The graphics driver may lack hardware video "
"encoding (VA-API or NVENC)."
msgstr ""
"Videokoderen startet ikke. Grafikkdriveren mangler kanskje maskinvarekoding "
"av video (VA-API eller NVENC)."

#: hotrec/recorder.py
#, python-format
msgid "%s is not a safe place for the state of the recording"
msgstr "%s er ikke et trygt sted for opptakets tilstand"

#: hotrec/recorder.py
msgid "The recording stopped"
msgstr "Opptaket ble stoppet"

#: hotrec/recorder.py
msgid "Could not find the sound output to record"
msgstr "Lydutgangen som skal tas opp ble ikke funnet"

#: hotrec/recorder.py
msgid "Could not start the recording"
msgstr "Opptaket kunne ikke startes"

#: hotrec/recorder.py
#, python-format
msgid "Could not create the folder %s"
msgstr "Mappen %s kunne ikke opprettes"

#: hotrec/recorder.py
#, python-format
msgid "%s is not installed"
msgstr "%s er ikke installert"

#: hotrec/recorder.py
#, python-format
msgid "%s did not start"
msgstr "%s startet ikke"

#: hotrec/recorder.py
#, python-format
msgid "Could not start the recording (log: %s)"
msgstr "Opptaket kunne ikke startes (logg: %s)"

#: hotrec/recorder.py
msgid "Recording saved"
msgstr "Opptaket er lagret"

#: hotrec/recorder.py
msgid "The recording may be incomplete"
msgstr "Opptaket kan være ufullstendig"

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. You can turn it off in "
"the Extensions app."
msgstr ""
"Den blinkende røde prikken over en fullskjermvideo er slått på. Du kan slå "
"den av i appen Utvidelser."

#: hotrec/shellext.py
msgid ""
"The blinking red dot over a fullscreen video is on. If you do not see it "
"yet, log out and in once. You can turn it off in the Extensions app."
msgstr ""
"Den blinkende røde prikken over en fullskjermvideo er slått på. Hvis du ikke "
"ser den ennå, logg ut og inn én gang. Du kan slå den av i appen Utvidelser."

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen and sound"
msgstr "Ta opp skjerm og lyd"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record screen only"
msgstr "Ta bare opp skjermen"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Record sound only"
msgstr "Ta bare opp lyden"

#: hotrec/shortcuts.py data/io.github.trensoft.hotrec.desktop.in
msgid "Pause or resume recording"
msgstr "Sett opptaket på pause eller fortsett"

#: data/io.github.trensoft.hotrec.desktop.in
#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Hotrec"
msgstr "Hotrec"

#: data/io.github.trensoft.hotrec.desktop.in
msgid "Record the screen and the sound of the desktop with keyboard shortcuts"
msgstr "Tar opp skjermen og lyden på skrivebordet med tastatursnarveier"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid "Screen and sound recorder with keyboard shortcuts"
msgstr "Skjerm- og lydopptaker med tastatursnarveier"

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"One key records the screen and the sound of the desktop, another only the "
"screen, another only the sound as an MP3. The same key stops and saves the "
"recording; a fourth key pauses it and resumes it."
msgstr ""
"Én tast tar opp skjermen og lyden på skrivebordet, en annen bare skjermen, "
"en tredje bare lyden som MP3. Samme tast stopper og lagrer opptaket; en "
"fjerde setter det på pause og fortsetter det."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The keys work in every window, also on Wayland. A red dot in the top bar "
"shows that a recording is running, a yellow one that it is paused."
msgstr ""
"Tastene virker i alle vinduer, også under Wayland. En rød prikk i den "
"øverste linjen viser at et opptak pågår, en gul at det er på pause."

#: data/io.github.trensoft.hotrec.metainfo.xml.in
msgid ""
"The screen is recorded by the graphics hardware. The folder, the file format "
"and the bit rates are set in a plain settings file."
msgstr ""
"Skjermen tas opp av grafikkmaskinvaren. Mappen, filformatet og bitrater "
"settes i en enkel innstillingsfil."
